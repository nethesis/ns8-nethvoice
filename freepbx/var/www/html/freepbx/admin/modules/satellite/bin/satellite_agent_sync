#!/usr/bin/env php
<?php
// Reconcile workflow destinations and send FreePBX agent settings to Satellite.
// The sync timer retries temporary failures.
try {
    $bootstrap_settings['freepbx_error_handler'] = false;
    define('FREEPBX_IS_AUTH', 1);
    require_once '/etc/freepbx.conf';
    require_once dirname(__DIR__) . '/lib/AgentConfigurationBuilder.php';
    require_once dirname(__DIR__) . '/lib/AgentWorkflowReconciler.php';
    try {
        $reconciled = AgentWorkflowReconciler::reconcile(FreePBX::Database());
        if ($reconciled['changed']) {
            needreload();
            exec('/var/www/html/freepbx/rest/lib/retrieveHelper.sh > /dev/null 2>&1 &');
        }
        if ($reconciled['pending']) { fwrite(STDERR, "Workflow PBX binding pending; retry scheduled.\n"); }
    } catch (\Throwable $error) { /* Application state must not block built-in synchronization. */ }
    (new AgentConfigurationBuilder(FreePBX::create()))->synchronize();
} catch (\Throwable $error) {
    fwrite(STDERR, "Satellite Agent synchronization failed; retry scheduled.\n");
    exit(1);
}
