              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "title": "backendVerbosity"
            },
            "service_tier": {
              "type": "string",
              "enum": [
                "auto",
                "default",
                "flex",
                "priority"
              ],
              "title": "serviceTier"
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192,
              "title": "maxOutputTokens"
            }
          }
        },
