{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_id",
    "destination_id",
    "workflow_version",
    "provider_binding_id",
    "provider",
    "conversation",
    "enabled_tools",
    "approved_destination_ids",
    "fallback_destination_id",
    "max_call_duration_seconds"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
    },
    "destination_id": {
      "type": "string",
      "pattern": "^agent:[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
    },
    "workflow_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "provider_binding_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
    },
    "provider": {
      "enum": [
        "openai",
        "grok"
      ]
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "voice",
        "greeting",
        "instructions"
      ],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$(?![\\s\\S])"
        },
        "voice": {
          "type": "string",
          "maxLength": 128
        },
        "greeting": {
          "type": "string",
          "maxLength": 4096
        },
        "instructions": {
          "type": "string",
          "maxLength": 32768
        }
      }
    },
    "enabled_tools": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "directory.find_destinations",
          "telephony.transfer"
        ]
      }
    },
    "approved_destination_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^extension:[0-9]{1,20}$(?![\\s\\S])"
      }
    },
    "fallback_destination_id": {
      "type": "string",
      "pattern": "^extension:[0-9]{1,20}$(?![\\s\\S])"
    },
    "max_call_duration_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nethvoice:agents:published:1",
  "title": "Published Basic Voice snapshot v1"
}
