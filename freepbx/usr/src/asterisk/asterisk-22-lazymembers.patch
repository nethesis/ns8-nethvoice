+/*!
+ * \internal
+ * \brief Reset an exhausted LazyMembers selection cycle.
+ *
+ * The outgoing list already contains only members accepted by calc_metric(),
+ * including the caller's current penalty range.  Reusing can_ring_entry_internal()
+ * without reserving the member applies the remaining queue selection rules and
+ * avoids the legacy patch's approximate member counting.
+ */
+static void queue_lazy_members_reset_exhausted_cycle(struct queue_ent *qe,
+	struct callattempt *outgoing)
+{
+	struct callattempt *call;
+	int have_eligible_excluded = 0;
+	int enabled;
+
+	ao2_lock(qe->parent);
+	enabled = qe->parent->lazymembers;
+	ao2_unlock(qe->parent);
+	if (!enabled) {
+		return;
+	}
+
+	for (call = outgoing; call; call = call->q_next) {
+		int excluded;
+
+		ao2_lock(qe->parent);
+		excluded = queue_member_is_lazy_excluded(qe->parent, call->member);
+		ao2_unlock(qe->parent);
+
+		if (excluded) {
+			/*
+			 * A just-timed-out attempt still owns its pending_members entry.
+			 * Ignore only that reservation while retaining all other effective
+			 * selection checks, including a fresh device-state lookup.
+			 */
+			if (can_ring_entry_internal(qe, call, 1, 0, call->lazy_noanswer)) {
+				have_eligible_excluded = 1;
+			}
+		} else if (can_ring_entry_internal(qe, call, 0, 0, 0)) {
+			/* At least one normally callable member remains in this cycle. */
+			return;
+		}
+	}
+
+	if (have_eligible_excluded) {
+		queue_lazy_members_reset(qe->parent, "all eligible members attempted");
+	}
+}
