+/*!
+ * \internal
+ * \brief Test whether a member is temporarily excluded by LazyMembers.
+ * \pre The queue is locked.
+ */
+static int queue_member_is_lazy_excluded(struct call_queue *q, struct member *mem)
+{
+	return q->lazymembers && mem->lazy_excluded;
+}
+
+/*!
+ * \internal
+ * \brief Clear all temporary LazyMembers exclusions.
+ * \pre The queue is locked or is not yet published.
+ * \return The number of exclusions cleared.
+ */
+static unsigned int queue_lazy_members_reset_locked(struct call_queue *q, const char *reason)
+{
+	struct ao2_iterator mem_iter;
+	struct member *mem;
+	unsigned int reset = 0;
+
+	if (!q->members) {
+		return 0;
+	}
+
+	mem_iter = ao2_iterator_init(q->members, 0);
+	while ((mem = ao2_iterator_next(&mem_iter))) {
+		if (mem->lazy_excluded) {
+			mem->lazy_excluded = 0;
+			++reset;
+		}
+		ao2_ref(mem, -1);
+	}
+	ao2_iterator_destroy(&mem_iter);
+
+	if (reset) {
+		ast_debug(1, "Queue '%s' reset %u LazyMembers exclusion%s (%s)\n",
+			q->name, reset, reset == 1 ? "" : "s", reason);
+	}
+
+	return reset;
+}
+
+/*!
+ * \internal
+ * \brief Clear LazyMembers exclusions and republish queue availability.
+ */
+static void queue_lazy_members_reset(struct call_queue *q, const char *reason)
+{
+	unsigned int reset;
+
+	ao2_lock(q);
+	reset = queue_lazy_members_reset_locked(q, reason);
+	if (reset) {
+		ast_devstate_changed(num_available_members(q) ? AST_DEVICE_NOT_INUSE : AST_DEVICE_INUSE,
+			AST_DEVSTATE_CACHABLE, "Queue:%s_avail", q->name);
+	}
+	ao2_unlock(q);
+}
+
+/*!
+ * \internal
+ * \brief Mark a current queue member after a ring-no-answer attempt.
+ * \return Non-zero if the exact member is still linked in the queue.
+ */
+static int queue_lazy_member_mark_noanswer(struct call_queue *q, struct member *mem)
+{
+	struct member *current;
+	int marked = 0;
+
+	ao2_lock(q);
+	if (!q->lazymembers) {
+		goto done;
+	}
+
+	/*
+	 * The call attempt owns a member reference, but a dynamic update may have
+	 * removed or replaced that object while its channel was ringing.  Only mark
+	 * the exact object that is still linked in this queue.
+	 */
+	current = ao2_find(q->members, mem, OBJ_POINTER);
+	if (current) {
+		if (current == mem) {
+			marked = 1;
+			if (!current->lazy_excluded) {
+				current->lazy_excluded = 1;
+				ast_debug(1, "Queue '%s' LazyMembers excluded member '%s' after ring-no-answer\n",
+					q->name, current->membername);
+				ast_devstate_changed(num_available_members(q) ? AST_DEVICE_NOT_INUSE : AST_DEVICE_INUSE,
+					AST_DEVSTATE_CACHABLE, "Queue:%s_avail", q->name);
+			}
+		}
+		ao2_ref(current, -1);
+	}
+
+done:
+	ao2_unlock(q);
+	return marked;
+}
