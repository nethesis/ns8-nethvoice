{
  "name": "nethvoice-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_E2E=true vite --port 5184 --strictPort",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --list-different src/ e2e/ playwright.config.ts",
    "format-fix": "prettier --write src/ e2e/ playwright.config.ts",
    "openapi:generate": "flock node_modules/.openapi.lock sh -c 'openapi-typescript ../var/www/html/freepbx/rest/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts'",
    "openapi:check": "mkdir -p .openapi-check && openapi-typescript ../var/www/html/freepbx/rest/openapi.yaml -o .openapi-check/schema.d.ts && prettier --ignore-path .prettierignore --write .openapi-check/schema.d.ts > /dev/null && diff -q .openapi-check/schema.d.ts src/lib/api/schema.d.ts; status=$?; rm -rf .openapi-check; exit $status",
    "openapi:lint": "redocly lint --config scripts/openapi-lint.yaml ../var/www/html/freepbx/rest/openapi.yaml",
    "pre-commit": "npm run format-fix && npm run lint && npm run type-check && npm run openapi:check && npm run test:unit -- --run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.6",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@headlessui/vue": "^1.7.23",
    "@nethesis/nethesis-light-svg-icons": "github:nethesis/Font-Awesome#ns-light",
    "@nethesis/nethesis-solid-svg-icons": "github:nethesis/Font-Awesome#ns-solid",
    "@nethesis/phone-island": "1.1.8-dev.6",
    "@nethesis/vue-components": "^3.15.1",
    "@pinia/colada": "^1.4.7",
    "@tailwindcss/vite": "^4.1.10",
    "@vueuse/core": "^13.4.0",
    "lodash": "^4.17.21",
    "openapi-fetch": "^0.14.0",
    "pinia": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.10",
    "valibot": "^1.4.2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@pinia/colada-devtools": "^1.1.2",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^1.34.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/lodash": "^4.17.18",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "openapi-typescript": "^7.8.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~5.9.0",
    "vite": "^6.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.8",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  }
}
