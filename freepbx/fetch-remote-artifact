#!/bin/sh
set -e

if [ "$#" -ne 2 ]; then
    printf "Usage: %s ARTIFACT URL\n" "$0" >&2
    exit 2
fi

manifest="${REMOTE_ARTIFACTS_MANIFEST:-/tmp/remote-artifacts.sha256}"
artifact="$1"
url="$2"

# Fetch GitHub archives directly to avoid gateway failures in archive redirects.
case "$url" in
    https://github.com/*/*/archive/*.tar.gz)
        github_path="${url#https://github.com/}"
        github_repo="${github_path%%/archive/*}"
        github_ref="${github_path#*/archive/}"
        url="https://codeload.github.com/${github_repo}/tar.gz/${github_ref%.tar.gz}"
        ;;
esac

curl -fsSL --retry 3 --retry-delay 5 "$url" -o "/tmp/${artifact}"
artifact_checksum=$(grep "  ${artifact}$" "$manifest")

(
    cd /tmp
    printf "%s\n" "${artifact_checksum}" | sha256sum -c -
)
