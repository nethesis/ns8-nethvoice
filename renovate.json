{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "dependencyDashboard": true,
  "postUpdateOptions": ["gomodTidy"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "freepbx/wizard-ui/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Asterisk 22 and its source archive checksum together",
      "managerFilePatterns": [
        "/^freepbx\\/Containerfile$/"
      ],
      "matchStrings": [
        "ARG ASTERISK_VERSION=(?<currentValue>\\S+)\\nARG ASTERISK_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "asterisk",
      "datasourceTemplate": "custom.asterisk-22",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track upstream FreePBX 17 module release tags",
      "managerFilePatterns": [
        "/^freepbx\\/Containerfile$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>(?:FreePBX|FreePBX-ContributedModules)/[^/\\s]+)/archive/refs/tags/release/(?<currentValue>[0-9.]+)\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^release/(?<version>17\\.[0-9]+(?:\\.[0-9]+)*)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(tancredi|saml2-proxy)\\/Containerfile$/"],
      "matchStrings": ["(?:^|\\n)ARG APACHE_MIN_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "apache2",
      "datasourceTemplate": "custom.debian-bookworm",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^freepbx\\/Containerfile$/"],
      "matchStrings": ["(?:^|\\n)ARG APACHE_MIN_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "apache2",
      "datasourceTemplate": "custom.debian-trixie",
      "versioningTemplate": "deb"
    }
  ],
  "customDatasources": {
    "asterisk-22": {
      "defaultRegistryUrlTemplate": "https://downloads.asterisk.org/pub/telephony/asterisk/asterisk-22-current.sha256",
      "format": "plain",
      "transformTemplates": [
        "($release := $match(releases[0].version, /^([a-f0-9]{64})\\s+asterisk-(22\\.[0-9]+\\.[0-9]+)\\.tar\\.gz$/); {\"releases\": [{\"version\": $release.groups[1], \"digest\": $release.groups[0]}], \"sourceUrl\": \"https://github.com/asterisk/asterisk\"})"
      ]
    },
    "debian-bookworm": {
      "defaultRegistryUrlTemplate": "https://packages.debian.org/bookworm/amd64/{{{packageName}}}/download",
      "format": "html"
    },
    "debian-trixie": {
      "defaultRegistryUrlTemplate": "https://packages.debian.org/trixie/amd64/{{{packageName}}}/download",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "Module updates need archive checksums and local patches reviewed before building",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "/^(FreePBX|FreePBX-ContributedModules)\\//"
      ],
      "groupName": "FreePBX modules",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Before building, refresh the changed module entries in freepbx/remote-artifacts.sha256. For framework, also update the bootstrap archive filenames and checksum. Review the local compatibility patches. From the repository root, run `sources=$(mktemp -d)`, then `python3 tools/prepare-freepbx-test-sources.py \"$sources\"` followed by `sh tools/test-freepbx.sh \"$sources\"`."
      ]
    },
    {
      "description": "Track Apache security updates using Debian download pages (the deb datasource requires unavailable Packages.gz indexes)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tancredi/Containerfile", "saml2-proxy/Containerfile", "freepbx/Containerfile"],
      "matchDatasources": ["custom.debian-bookworm", "custom.debian-trixie"],
      "matchDepNames": ["apache2"],
      "extractVersion": "^https?://[^?#]+/apache2_(?<version>[^_]+)_amd64\\.deb$",
      "groupName": "Apache"
    },
    {
      "description": "nethcti-server and the reports UI build on Node 14: major bumps break node-sass",
      "matchFileNames": ["nethcti-server/**", "reports/**"],
      "matchDepNames": ["docker.io/library/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "FreePBX 17 does not start on PHP 8.4+: PHP minor and major updates wait for approval in the Dependency Dashboard (move with FreePBX 18)",
      "matchFileNames": ["freepbx/**", "tancredi/**"],
      "matchDepNames": ["docker.io/library/php"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "MariaDB major upgrades need a tested data upgrade: they wait for approval in the Dependency Dashboard",
      "matchDepNames": ["mariadb"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The NethCTI Middleware CI MariaDB service stays on the 10.11 series shipped by the module",
      "matchFileNames": [".github/workflows/cti-middleware-tests.yml"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "<10.12"
    },
    {
      "description": "Satellite: deepgram-sdk v4+ is a rewrite with breaking API changes, stay on 3.x until migrated",
      "matchFileNames": ["satellite/**"],
      "matchPackageNames": ["deepgram-sdk"],
      "allowedVersions": "<4"
    },
    {
      "description": "Reports UI is Vue 2 on vue-cli 4: no major updates of the Vue toolchain without a migration",
      "matchFileNames": ["reports/ui/**"],
      "matchManagers": ["npm"],
      "matchPackageNames": ["vue", "vue-*", "@vue/**", "chart.js", "portal-vue", "sass-loader", "eslint", "eslint-plugin-vue", "@babel/eslint-parser", "chai"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Reports UI: node-sass majors need a newer sass-loader and vue-cli, so they wait for approval in the Dependency Dashboard (security updates too)",
      "matchFileNames": ["reports/ui/**"],
      "matchManagers": ["npm"],
      "matchPackageNames": ["node-sass"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "nethcti-server runs on Node 14 and Sequelize 3: these majors need a migration, so they wait for approval in the Dependency Dashboard (security updates too)",
      "matchFileNames": ["nethcti-server/**"],
      "matchManagers": ["npm"],
      "matchPackageNames": ["sequelize", "mysql2", "nodemailer", "uuid"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "reports/tasks uses reports/api through a local replace: update its indirect pins too, so api updates land in the same PR and the reports image builds",
      "matchManagers": ["gomod"],
      "matchFileNames": ["reports/tasks/go.mod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Reports: group non-major updates of indirect Go dependencies in one PR. Direct dependencies of reports/api stay out of the group (they are indirect in reports/tasks and must move in the same PR as the api change), and so do majors",
      "matchManagers": ["gomod"],
      "matchFileNames": ["reports/**"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchPackageNames": [
        "!github.com/appleboy/gin-jwt/v2",
        "!github.com/gin-contrib/cors",
        "!github.com/gin-contrib/gzip",
        "!github.com/gin-gonic/gin",
        "!github.com/go-redis/redis",
        "!github.com/go-sql-driver/mysql",
        "!github.com/google/uuid",
        "!github.com/jinzhu/gorm",
        "!github.com/juliangruber/go-intersect",
        "!github.com/nleeper/goment",
        "!github.com/pkg/errors",
        "!github.com/ziutek/rrd",
        "!golang.org/x/time"
      ],
      "groupName": "reports indirect Go dependencies"
    },
    {
      "description": "node-ipc had malicious releases (9.2.2, 10.1.x) and new 9.x releases appeared in 2026: every update waits for approval in the Dependency Dashboard and needs a code review",
      "matchFileNames": ["nethcti-server/**"],
      "matchManagers": ["npm"],
      "matchPackageNames": ["node-ipc"],
      "dependencyDashboardApproval": true
    }
  ]
}
