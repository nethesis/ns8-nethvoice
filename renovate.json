{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "dependencyDashboard": true,
  "postUpdateOptions": ["gomodTidy"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "freepbx/wizard-ui/**"
  ],
  "packageRules": [
    {
      "description": "nethcti-server and the reports UI build on Node 14: major bumps break node-sass",
      "matchFileNames": ["nethcti-server/**", "reports/**"],
      "matchDepNames": ["docker.io/library/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "FreePBX 17 does not start on PHP 8.4+: PHP minor and major updates wait for approval in the Dependency Dashboard (move with FreePBX 18)",
      "matchFileNames": ["freepbx/**", "tancredi/**"],
      "matchDepNames": ["docker.io/library/php"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "MariaDB major upgrades need a tested data upgrade: they wait for approval in the Dependency Dashboard",
      "matchDepNames": ["mariadb"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The NethCTI Middleware CI MariaDB service stays on the 10.11 series shipped by the module",
      "matchFileNames": [".github/workflows/cti-middleware-tests.yml"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "<10.12"
    },
    {
      "description": "Satellite: deepgram-sdk v4+ is a rewrite with breaking API changes, stay on 3.x until migrated",
      "matchFileNames": ["satellite/**"],
      "matchPackageNames": ["deepgram-sdk"],
      "allowedVersions": "<4"
    },
    {
      "description": "Reports UI is Vue 2 on vue-cli 4: no major updates of the Vue toolchain without a migration",
      "matchFileNames": ["reports/ui/**"],
      "matchManagers": ["npm"],
      "matchPackageNames": ["vue", "vue-*", "@vue/**", "chart.js", "portal-vue", "node-sass", "sass-loader", "eslint", "eslint-plugin-vue", "@babel/eslint-parser", "chai"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
