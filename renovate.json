{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "freepbx/wizard-ui/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(tancredi|saml2-proxy)\\/Containerfile$/"],
      "matchStrings": ["(?:^|\\n)ARG APACHE_MIN_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "apache2",
      "datasourceTemplate": "custom.debian-bookworm",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^freepbx\\/Containerfile$/"],
      "matchStrings": ["(?:^|\\n)ARG APACHE_MIN_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "apache2",
      "datasourceTemplate": "custom.debian-trixie",
      "versioningTemplate": "deb"
    }
  ],
  "customDatasources": {
    "debian-bookworm": {
      "defaultRegistryUrlTemplate": "https://packages.debian.org/bookworm/amd64/{{{packageName}}}/download",
      "format": "html"
    },
    "debian-trixie": {
      "defaultRegistryUrlTemplate": "https://packages.debian.org/trixie/amd64/{{{packageName}}}/download",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "Track Apache security updates using Debian download pages (the deb datasource requires unavailable Packages.gz indexes)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["tancredi/Containerfile", "saml2-proxy/Containerfile", "freepbx/Containerfile"],
      "matchDatasources": ["custom.debian-bookworm", "custom.debian-trixie"],
      "matchDepNames": ["apache2"],
      "extractVersion": "^https?://[^?#]+/apache2_(?<version>[^_]+)_amd64\\.deb$",
      "groupName": "Apache"
    },
    {
      "description": "nethcti-server and the reports UI build on Node 14: major bumps break node-sass",
      "matchFileNames": ["nethcti-server/**", "reports/**"],
      "matchDepNames": ["docker.io/library/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "FreePBX 17 does not start on PHP 8.4+: PHP minor and major updates wait for approval in the Dependency Dashboard (move with FreePBX 18)",
      "matchFileNames": ["freepbx/**", "tancredi/**"],
      "matchDepNames": ["docker.io/library/php"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "MariaDB major upgrades need a tested data upgrade: they wait for approval in the Dependency Dashboard",
      "matchDepNames": ["mariadb"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
