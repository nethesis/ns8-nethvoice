<<VOIP CONFIG FILE>>Version:2.0000000000
{#
  Fanvil i6x video door phones (i60/i60K, i61, i62, i63, i64; firmware 2.12.x)

  Partial configuration: only the keys below are changed on the device.
  Network, web server and access control settings are never written: the
  door-open passwords are rules of the EGS password list of the device, not
  configuration keys, and keep the values set from the web interface.

  Key names checked against the configuration exported by a Fanvil i62 with
  firmware 2.12.51. RTSP credentials come from the per-phone variables
  door_rtsp_user and door_rtsp_password; with cap_door_rtsp_adminpw the RTSP
  password is the web admin password (adminpw): firmware 2.12.51 of the i62
  keeps the RTSP password equal to the password of the web admin user and
  ignores a different "RTSP Server Passwd". An empty password leaves the
  device RTSP credentials untouched. The camera streams (video1 main, video2 sub)
  get a lower main bitrate, a VGA sub stream and frequent keyframes, so that
  the keyframes stay small: see the door_video_* model variables. The
  language is not written: the i62 keeps its own web interface language.
#}
{% import 'fanvil.macros' as fanvil %}

<MM CONFIG MODULE>
Dtmf Payload Type  :101

<SIP CONFIG MODULE>
SIP  Port          :5060
--SIP Line List--  :
{% if account_username_1 is defined %}
SIP1 Phone Number       :{{ account_username_1 }}
SIP1 Display Name       :{{ account_display_name_1 }}
SIP1 Sip Name           :{{ account_username_1 }}
SIP1 Register Addr      :{{ hostname }}
SIP1 Register Port      :{{ account_encryption_1 ? sip_tls_port : sip_udp_port }}
SIP1 Register User      :{{ account_username_1 }}
SIP1 Register Pswd      :{{ account_password_1 }}
SIP1 Register TTL       :3600
SIP1 Enable Reg         :1
SIP1 Proxy Addr         :{{ outbound_proxy_1 is defined ? outbound_proxy_1 : '' }}
SIP1 Proxy Port         :{{ outbound_proxy_port_1 is defined ? outbound_proxy_port_1 : account_encryption_1 ? '5061' : '5060' }}
SIP1 Media Crypto       :{{ account_encryption_1 ? '2' : '0' }}
SIP1 DTMF Mode          :{{ fanvil.dtmf_map(account_dtmf_type_1) }}
SIP1 DTMF Info Mode     :0
SIP1 Transport          :{{ account_encryption_1 ? '3' : '0' }}
SIP1 VoiceCodecMap      :G722,PCMU,PCMA
SIP1 VideoCodecMap      :H264
SIP1 TLS Version        :2
{% endif %}

<PHONE FEATURE MODULE>
--DateTime Config--:
Enable SNTP        :1
SNTP Server        :{{ ntp_server | default('pool.ntp.org') }}
Second SNTP Server :
Time Zone          :{{ fanvil.tz_map(timezone, 'offset') }}
Time Zone Name     :{{ fanvil.tz_map(timezone, 'name') }}
SNTP Timeout       :3600
DST Type           :1
DST Location       :{{ fanvil.tz_map(timezone, 'location') }}

<MMI CONFIG MODULE>
--MMI Account--    :
Account1 Name               :admin
Account1 Password           :{{ adminpw | default('admin') }}
Account1 Level              :10

<AUTOUPDATE CONFIG MODULE>
Flash Server IP    :{{ hostname }}
Flash File Name    :{{ 'http' in provisioning_url_scheme ? (provisioning_url_path | trim('/', 'left') ~ tok2 ~ '/$mac.cfg') : '$mac.cfg' }}
Flash Protocol     :{{ fanvil.scheme_map(provisioning_url_scheme) }}
Flash Mode         :{{ (provisioning_complete and provisioning_freq == 'never') ? '1' : '2' }}
Flash Interval     :{{ provisioning_complete ? fanvil.upgrade_wait_hours(timezone, short_mac) : '1' }}

{% if door_video_sub_bitrate is defined and door_video_sub_bitrate != '' %}
<CAMERA CONFIG MODULE>
--Video Stream-- :
video1 BitRate          :{{ door_video_main_bitrate }}
video1 I Frame Interval :{{ door_video_iframe_interval }}
video2 BitRate          :{{ door_video_sub_bitrate }}
video2 Resolution       :{{ door_video_sub_resolution }}
video2 I Frame Interval :{{ door_video_iframe_interval }}

{% endif %}
<RTSP SERVER CONFIG MODULE>
Enable RTSP        :1
{% set rtsp_password = door_rtsp_password | default('') %}
{% if rtsp_password == '' and cap_door_rtsp_adminpw | default('') %}
{% set rtsp_password = adminpw | default('') %}
{% endif %}
{% if rtsp_password != '' %}
Enable RTSP Auth   :1
RTSP Server User   :{{ door_rtsp_user | default('admin') }}
RTSP Server Passwd :{{ rtsp_password }}
{% endif %}
<<END OF FILE>>
