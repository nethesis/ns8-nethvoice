<<VOIP CONFIG FILE>>Version:2.0000000000
{#
  Fanvil i6x video door phones (i60/i60K, i61, i62, i63, i64; firmware 2.12.x)

  Partial configuration: only the keys below are changed on the device.
  Network, web server and access control (EGS) settings are never written:
  the door-open passwords of the EGS password list keep the values set from
  the web interface.

  Key names checked against the configuration exported by a Fanvil i62 with
  firmware 2.12.51. RTSP credentials come from the per-phone variables
  door_rtsp_user and door_rtsp_password; without door_rtsp_password the RTSP
  password is the web admin password (adminpw), written as password of the
  web user admin (MMI Account1) like on the other Fanvil phones. Without
  both, the device credentials are left untouched. The camera streams (video1 main, video2 sub)
  get a lower main bitrate, a VGA sub stream and frequent keyframes, so that
  the keyframes stay small: see the door_video_* model variables. The
  language is not written: the i62 keeps its own web interface language.

  The call buttons are the "SoftDss" keys of the DSSKEY CONFIG MODULE
  (Fkey1..FkeyN, N = cap_linekey_count of the model): the i62 export maps
  the physical buttons to them with "Desktop Click :dss1;dss2;...", which is
  not written. Every key is a speed dial, whatever linekey_type says: only
  the keys with a linekey_value are written, so a key set from the web
  interface stays as it is until the PBX sets a number for that key.

  The relays are the outputs of the SECURITY CONFIG MODULE (Output1 is
  Relay1, Output2 is Relay2; cap_door_relay_count of the model). A relay
  opens when the device receives its DTMF code during a call: door_dtmf_code
  for relay 1 (the code the PBX sends to open the door), door_dtmf_code_2
  for relay 2. door_relay_duration_N sets how long the relay stays active, in
  seconds. A relay without a code is not written, so the tokenless
  provisioning, which strips the codes, leaves the relays as they are.
#}
{% import 'fanvil.macros' as fanvil %}
{% import 'language.macros' as l10n %}

<MM CONFIG MODULE>
Dtmf Payload Type  :101

<SIP CONFIG MODULE>
SIP  Port          :5060
--SIP Line List--  :
{% if account_username_1 is defined %}
SIP1 Phone Number       :{{ account_username_1 }}
SIP1 Display Name       :{{ account_display_name_1 }}
SIP1 Sip Name           :{{ account_username_1 }}
SIP1 Register Addr      :{{ hostname }}
SIP1 Register Port      :{{ account_encryption_1 ? sip_tls_port : sip_udp_port }}
SIP1 Register User      :{{ account_username_1 }}
SIP1 Register Pswd      :{{ account_password_1 }}
SIP1 Register TTL       :3600
SIP1 Enable Reg         :1
SIP1 Proxy Addr         :{{ outbound_proxy_1 is defined ? outbound_proxy_1 : '' }}
SIP1 Proxy Port         :{{ outbound_proxy_port_1 is defined ? outbound_proxy_port_1 : account_encryption_1 ? '5061' : '5060' }}
SIP1 Media Crypto       :{{ account_encryption_1 ? '2' : '0' }}
SIP1 DTMF Mode          :{{ fanvil.dtmf_map(account_dtmf_type_1) }}
SIP1 DTMF Info Mode     :0
SIP1 Transport          :{{ account_encryption_1 ? '3' : '0' }}
SIP1 VoiceCodecMap      :G722,PCMU,PCMA
SIP1 VideoCodecMap      :H264
SIP1 TLS Version        :2
{% endif %}

<PHONE FEATURE MODULE>
--DateTime Config--:
Enable SNTP        :1
SNTP Server        :{{ ntp_server | default('pool.ntp.org') }}
Second SNTP Server :
Time Zone          :{{ fanvil.tz_map(timezone, 'offset') }}
Time Zone Name     :{{ fanvil.tz_map(timezone, 'name') }}
SNTP Timeout       :3600
DST Type           :1
DST Location       :{{ fanvil.tz_map(timezone, 'location') }}

<AUTOUPDATE CONFIG MODULE>
Flash Server IP    :{{ hostname }}
Flash File Name    :{{ 'http' in provisioning_url_scheme ? (provisioning_url_path | trim('/', 'left') ~ tok2 ~ '/$mac.cfg') : '$mac.cfg' }}
Flash Protocol     :{{ fanvil.scheme_map(provisioning_url_scheme) }}
Flash Mode         :{{ (provisioning_complete and provisioning_freq == 'never') ? '1' : '2' }}
Flash Interval     :{{ provisioning_complete ? fanvil.upgrade_wait_hours(timezone, short_mac) : '1' }}

{% set door_keys = [] %}
{% for index in (cap_linekey_count | default(0)) > 0 ? range(1, cap_linekey_count) : [] %}
{% if _context['linekey_value_' ~ index] | default('') != '' %}
{% set door_keys = door_keys | merge([index]) %}
{% endif %}
{% endfor %}
{% if door_keys | length > 0 %}
<DSSKEY CONFIG MODULE>
--SoftDss Config-- :
{% for index in door_keys %}
{{ fanvil.linekey_type_map(
    'speed_dial',
    _context['linekey_value_' ~ index],
    _context['linekey_label_' ~ index] | default(''),
    index,
    l10n,
    language | default('en'),
    pickup_direct | default(''),
    pickup_group | default(''),
    'attended',
    queuetoggle | default('')
) }}
{% endfor %}

{% endif %}

{% set door_relay_codes = [door_dtmf_code | default(''), door_dtmf_code_2 | default('')] %}
{% set door_relays = [] %}
{% for relay in (cap_door_relay_count | default(0)) > 0 ? range(1, min(cap_door_relay_count, 2)) : [] %}
{% if door_relay_codes[relay - 1] != '' %}
{% set door_relays = door_relays | merge([relay]) %}
{% endif %}
{% endfor %}
{% if door_relays | length > 0 %}
<SECURITY CONFIG MODULE>
--Output List--    :
{% for relay in door_relays %}
{% set relay_duration = _context['door_relay_duration_' ~ relay] | default('') %}
Output{{ relay }} Enabled           :1
Output{{ relay }} Trigger By DTMF    :1
Output{{ relay }} DTMF Trigger Code  :{{ door_relay_codes[relay - 1] }}
{% if relay_duration != '' %}
Output{{ relay }} Trigger Duration  :{{ relay_duration }}
{% endif %}
{% endfor %}

{% endif %}
{% if door_video_sub_bitrate is defined and door_video_sub_bitrate != '' %}
<CAMERA CONFIG MODULE>
--Video Stream-- :
video1 BitRate          :{{ door_video_main_bitrate }}
video1 I Frame Interval :{{ door_video_iframe_interval }}
video2 BitRate          :{{ door_video_sub_bitrate }}
video2 Resolution       :{{ door_video_sub_resolution }}
video2 I Frame Interval :{{ door_video_iframe_interval }}

{% endif %}
{% set web_password = adminpw | default('') %}
{% set rtsp_password = door_rtsp_password | default('') != '' ? door_rtsp_password : web_password %}
{% if web_password != '' %}
<MMI CONFIG MODULE>
--MMI Account--    :
Account1 Name               :admin
Account1 Password           :{{ web_password }}
Account1 Level              :10

{% endif %}
<RTSP SERVER CONFIG MODULE>
Enable RTSP        :1
{% if rtsp_password != '' %}
Enable RTSP Auth   :1
RTSP Server User   :{{ door_rtsp_user | default('admin') }}
RTSP Server Passwd :{{ rtsp_password }}
{% endif %}
<<END OF FILE>>
