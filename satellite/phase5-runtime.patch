+            with zipfile.ZipFile(io.BytesIO(raw)) as archive:
+                if len(archive.infolist()) > 1000 or sum(item.file_size for item in archive.infolist()) > 64 * 1024**2:
+                    raise ApplicationError("workbook_too_large")
