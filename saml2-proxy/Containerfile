# Shibboleth SAML2 SP for the NethVoice CTI SSO. The files under etc/ mirror
# the container filesystem and are rendered in place at start by entrypoint.sh.
FROM docker.io/library/debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
ARG APACHE_VERSION=2.4.71-1~deb12u1
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        apache2=${APACHE_VERSION} \
        apache2-bin=${APACHE_VERSION} \
        apache2-data=${APACHE_VERSION} \
        apache2-utils=${APACHE_VERSION} \
        libapache2-mod-shib \
        curl \
        ca-certificates \
        gettext-base \
    && a2enmod shib headers setenvif \
    && sed -i 's/^Listen 80$//' /etc/apache2/ports.conf \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt /usr/share/doc /usr/share/man /usr/share/locale
COPY etc/shibboleth /etc/shibboleth
COPY etc/apache2/sites-available/000-default.conf /etc/apache2/sites-available/000-default.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
