    {
      "id": 9,
      "type": "stat",
      "title": "Services",
      "description": "State of each service now. Crash loop: systemd restarted it at least 3 times in 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (nethvoice_service_up{module_id=\"__MODULE_ID__\"}) + 2 * max by (service) (increase(nethvoice_service_restarts_total{module_id=\"__MODULE_ID__\"}[10m]) >= bool 3)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (nethvoice_proxy_service_up{module_id=\"$proxy\"}) + 2 * max by (service) (increase(nethvoice_proxy_service_restarts_total{module_id=\"$proxy\"}[10m]) >= bool 3)",
          "legendFormat": "proxy {{service}}",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "up",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "crash loop",
                  "color": "dark-red",
                  "index": 2
                },
                "3": {
                  "text": "crash loop",
                  "color": "orange",
                  "index": 3
                }
              }
            }
