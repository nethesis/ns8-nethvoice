# Set the port-migration notice status. Accepts {"seen": bool} (default true):
# when seen the Status page stops showing the banner. The mapping itself is
# kept for reference until the next migration overwrites it.

import json
import sys

import agent

request = json.load(sys.stdin)
seen = request.get("seen", True)

agent.set_env("PORTS_MIGRATION_SEEN", "1" if seen else "0")
