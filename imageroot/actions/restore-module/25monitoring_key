#!/usr/bin/env python3
# Older backups have no encrypted Agent history or content key.
import base64
import secrets
import agent

passwords = agent.read_envfile('passwords.env')
if not passwords.get('SATELLITE_AGENT_CONFIG_KEY'):
    passwords['SATELLITE_AGENT_CONFIG_KEY'] = secrets.token_urlsafe(48)
if not passwords.get('SATELLITE_MONITORING_CONTENT_KEY'):
    passwords['SATELLITE_MONITORING_CONTENT_KEY'] = base64.b64encode(secrets.token_bytes(32)).decode()
if not passwords.get('SATELLITE_APPLICATION_CONTENT_KEY'):
    passwords['SATELLITE_APPLICATION_CONTENT_KEY'] = base64.b64encode(secrets.token_bytes(32)).decode()
if not passwords.get('SATELLITE_WORKFLOW_DB_PASSWORD'):
    passwords['SATELLITE_WORKFLOW_DB_PASSWORD'] = secrets.token_urlsafe(32)
agent.write_envfile('passwords.env', passwords)
