set -e -o pipefail
exec 1>&2

# Older backups can legitimately have no Satellite database.
if [ ! -s satellite_postgresql.pg_dump.gz ]; then
    exit 0
fi
SATELLITE_PGSQL_PASSWORD=$(grep '^SATELLITE_PGSQL_PASSWORD=' ./passwords.env) && export "${SATELLITE_PGSQL_PASSWORD?}"
export POSTGRES_PASSWORD="${SATELLITE_PGSQL_PASSWORD}"
mkdir -vp restore
cat >restore/satellite_postgresql_restore.sh <<'EOS'
set -e -o pipefail
cleanup() {
    ec=$?
    trap - EXIT
    docker_temp_server_stop
    exit "$ec"
}
trap cleanup EXIT
# A unique bootstrap role avoids colliding with roles recreated by pg_dumpall.
# Fail on all SQL errors rather than silently accepting an incomplete restore.
gunzip -c /tmp/satellite_postgresql.pg_dump.gz | psql -X -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1
psql -X -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=1 -v restore_user="$POSTGRES_USER" <<'SQL'
ALTER ROLE :"restore_user" NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
SQL
EOS

restore_role="restore_$(cat /proc/sys/kernel/random/uuid | tr -d '-')"
podman run \
    --rm --interactive --network=none \
    --volume=./restore:/docker-entrypoint-initdb.d/:Z \
    --volume=satellite_pgdata:/var/lib/postgresql/18/docker:Z \
    --volume=./satellite_postgresql.pg_dump.gz:/tmp/satellite_postgresql.pg_dump.gz:Z \
    --replace --name=restore_db \
    --env POSTGRES_USER="${restore_role}" \
    --env POSTGRES_DB=postgres \
    --env POSTGRES_PASSWORD \
    --env TZ=UTC \
    "${PGVECTOR_IMAGE}"
rm -rfv restore/ satellite_postgresql.pg_dump.gz
