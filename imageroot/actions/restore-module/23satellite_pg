set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# Satellite is optional, so older backups may not contain a dump or credentials.
dump=satellite_postgresql.pg_dump.gz
if [[ ! -e "$dump" ]]; then
    exit 0
fi

# Validate the entire gzip stream, including the case of an empty SQL payload.
dump_bytes=$(gzip -cd "$dump" | wc -c)
if (( dump_bytes == 0 )); then
    echo 'The Satellite PostgreSQL dump is empty'
    exit 1
fi

POSTGRES_PASSWORD=$(sed -n 's/^SATELLITE_PGSQL_PASSWORD=//p' ./passwords.env)
: "${POSTGRES_PASSWORD:?Missing Satellite PostgreSQL password}"
export POSTGRES_PASSWORD

restore_hook=$(mktemp "$PWD/.satellite-restore.XXXXXXXX")
trap 'rm -f -- "$restore_hook"' EXIT
cat >"$restore_hook" <<'RESTORE_SQL'
# shellcheck shell=bash
# Sourced by docker-enforce-initdb.sh with errexit and pipefail enabled.
# pg_dumpall creates the role that initdb just created. Skip only that
# statement so its saved password, settings and any matching COPY data survive.
bootstrap_role=$(docker_process_sql -Atc "SELECT format('CREATE ROLE %I;', current_user)")
export bootstrap_role
gzip -cd /tmp/satellite_postgresql.pg_dump.gz |
    awk '!skipped && $0 == ENVIRON["bootstrap_role"] { skipped = 1; next } { print }' |
    docker_process_sql
RESTORE_SQL
# PostgreSQL sources non-executable hooks as the container's postgres user.
chmod 0644 "$restore_hook"

# The image's init-only command refuses an existing database and stops after import.
podman run \
    --rm \
    --network=none \
    --volume="$restore_hook:/docker-entrypoint-initdb.d/restore.sh:ro,Z" \
    --volume=satellite_pgdata:/var/lib/postgresql/18/docker:Z \
    --volume="./$dump:/tmp/$dump:ro,Z" \
    --name=restore_db \
    --env POSTGRES_USER="${SATELLITE_PGSQL_USER:?}" \
    --env POSTGRES_PASSWORD \
    --env POSTGRES_DB=postgres \
    --env TZ=UTC \
    "${PGVECTOR_IMAGE:?}" docker-enforce-initdb.sh

rm -v -- "$dump"
