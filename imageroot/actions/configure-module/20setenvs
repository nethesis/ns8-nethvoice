import base64
import json
import os
import sys

import agent


def b64(value):
    """Multi-line values (PEM certificates) are stored base64-encoded:
    the environment file is line-based."""
    return base64.b64encode(value.encode()).decode() if value else ''

request = json.load(sys.stdin)

def getFromRequest(request, var_name, env_name, default = ""):
    if var_name in request:
        agent.set_env(env_name, request[var_name])
    else:
        agent.set_env(env_name, default)

getFromRequest(request, 'nethvoice_host', 'NETHVOICE_HOST', '')
getFromRequest(request, 'timezone', 'TIMEZONE', 'UTC')

## NethCTI UI
getFromRequest(request, 'nethcti_ui_host', 'NETHCTI_UI_HOST', '')

# Set APP Brand ID if present in the request, this attribute is only used
# by the migration tool procedure.
# Deprecated, will be removed in future releases.
if "app_brand_id" in request:
    agent.set_env('BRAND_APPID', request['app_brand_id'])

# Authentication method: 'password' checks credentials against the user domain,
# 'saml2' delegates to an external IdP (wiring applied by 45authentication).
authentication_method = request.get('authentication_method', 'password')
if authentication_method not in ('password', 'saml2'):
    authentication_method = 'password'
agent.set_env('AUTHENTICATION_METHOD', authentication_method)

saml2 = request.get('saml2', {}) or {}
agent.set_env('SAML2_IDP_METADATA_URL', saml2.get('idp_metadata_url', ''))
agent.set_env('SAML2_IDENTITY_ATTRIBUTE', saml2.get('identity_attribute', '') or 'uid')
agent.set_env('SAML2_LOGIN_BUTTON_LABEL', saml2.get('login_button_label', ''))
# optional hardening knobs (default off); fields absent from the payload keep
# their current value, so the settings form does not wipe API-set options
agent.set_env('SAML2_USER_ALLOWLIST', saml2.get('user_allowlist', os.getenv('SAML2_USER_ALLOWLIST', '')))
agent.set_env('SAML2_IDENTITY_VALUE_REGEX', saml2.get('identity_value_regex', os.getenv('SAML2_IDENTITY_VALUE_REGEX', '')))
if 'idp_signing_cert' in saml2:
    agent.set_env('SAML2_IDP_SIGNING_CERT', b64(saml2.get('idp_signing_cert', '')))
agent.set_env('SAML2_JWT_TIMEOUT_HOURS', str(saml2.get('jwt_timeout_hours', os.getenv('SAML2_JWT_TIMEOUT_HOURS', '')) or ''))
