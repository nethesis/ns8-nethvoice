import json
import os
import sys

import agent
import agent.tasks

# Find default proxy  instance for current node
proxy_id = agent.resolve_agent_id('nethvoice-proxy@node')
if proxy_id is None:
    sys.exit(2)

# Get proxy srv records
ksrv = agent.list_service_providers(agent.redis_connect(use_replica=True), "sip", "tcp", {"module_id": proxy_id.removeprefix("module/")})

# Set environment variables for nethvoice-proxy
agent.set_env("NETHVOICE_PROXY_FQDN", ksrv[0]["fqdn"])
agent.set_env("PROXY_IP", ksrv[0]["host"])
agent.set_env("PROXY_PORT", ksrv[0]["port"])

# Configure nethvoice-proxy to route SIP traffic for Nethvoice
response = agent.tasks.run(
    agent_id=proxy_id,
    action='add-route',
    data={
        'domain': os.environ["NETHVOICE_HOST"],
        'address': [{"uri":"sip:"+ ksrv[0]["host"] +":"+os.environ["ASTERISK_SIP_UDP_PORT"],"description":os.environ["MODULE_ID"]}],
    },
    extra={'isNotificationHidden': True},
)

# Check if proxy configuration has been successfull
agent.assert_exp(response['exit_code'] == 0)

# Refresh aliases too, including current destinations to retry failed reloads.
ports = {os.environ["ASTERISK_SIP_PORT"], os.environ["ASTERISK_SIP_UDP_PORT"]}
# Previous ports may have been reassigned to another instance after the update.
if os.environ.get("AGENT_TASK_ACTION") == "update-module":
    ports.add(os.environ.get("PREVIOUS_SIP_UDP_PORT"))
    ports.update(json.loads(os.environ.get("PREVIOUS_SIP_UDP_PORTS", "[]")))
uris = {"sip:" + ksrv[0]["host"] + ":" + port for port in ports if port}
new_uri = "sip:" + ksrv[0]["host"] + ":" + os.environ["ASTERISK_SIP_UDP_PORT"]
try:
    response = agent.tasks.run(agent_id=proxy_id, action="list-routes", data={},
                               extra={"isNotificationHidden": True})
    if response["exit_code"] != 0:
        raise RuntimeError("Cannot list SIP aliases")
except Exception as ex:
    print(agent.SD_WARNING + f"Cannot list SIP aliases ({type(ex).__name__}); skipping alias refresh",
          file=sys.stderr)
    sys.exit(0)
for route in response["output"]:
    if route["domain"] == os.environ["NETHVOICE_HOST"]:
        continue
    changed = False
    for address in route["address"]:
        uri, separator, parameters = address["uri"].partition(";")
        if uri not in uris:
            continue
        if any(p.lower().startswith("transport=") and p.lower() != "transport=udp"
               for p in parameters.split(";")):
            continue
        address["uri"] = new_uri + separator + parameters
        changed = True
    if changed:
        try:
            response = agent.tasks.run(agent_id=proxy_id, action="add-route", data=route,
                                       extra={"isNotificationHidden": True})
            if response["exit_code"] != 0:
                raise RuntimeError("Cannot refresh SIP alias")
        except Exception as ex:
            print(agent.SD_WARNING + f"Cannot refresh SIP alias {route['domain']} ({type(ex).__name__})",
                  file=sys.stderr)
