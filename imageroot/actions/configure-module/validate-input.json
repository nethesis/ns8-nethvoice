{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure NethVoice",
    "$id": "http://nethserver.org/json-schema/task/input/nethvoice/configure",
    "description": "Configure NethVoice",
    "examples": [
        {
            "nethvoice_host": "voice.ns8.local",
            "nethcti_ui_host": "cti.ns8.local",
            "user_domain": "domain.ns8.local",
            "reports_international_prefix": "+39"
        },
        {
            "nethvoice_host": "voice.ns8.local",
            "nethcti_ui_host": "cti.ns8.local",
            "user_domain": "domain.ns8.local",
            "reports_international_prefix": "0039"
        }
    ],
    "type": "object",
    "required": [
        "nethvoice_host",
        "nethcti_ui_host",
        "reports_international_prefix"
    ],
    "properties": {
        "nethvoice_host": {
            "description": "Host where NethVoice instance should be exposed to",
            "type": "string",
            "format": "hostname",
            "pattern": "\\.",
            "not": {
                "format": "ipv4"
            }
        },
        "nethcti_ui_host": {
            "description": "CTI host, must be different than nethvoice_host",
            "type": "string",
            "format": "hostname",
            "pattern": "\\.",
            "not": {
                "format": "ipv4"
            }
        },
        "lets_encrypt": {
            "description": "Enable Let's Encrypt certificate",
            "type": "boolean"
        },
        "user_domain": {
            "description": "Domain where the user accessing NethVoice are stored",
            "type": "string"
        },
        "app_brand_id": {
            "description": "Mobile app brand ID used for push proxy",
            "type": "string"
        },
        "reports_international_prefix": {
            "description": "International prefix for the reports.",
            "type": "string",
            "pattern": "^(00\\d{1,4}|\\+\\d{1,4})$"
        },
        "timezone": {
            "description": "Asterisk Timezone for timeconditions",
            "type": "string"
        },
        "authentication_method": {
            "description": "How users prove their identity: local password, SAML2 or OIDC SSO",
            "type": "string",
            "enum": ["password", "saml2", "oidc"]
        },
        "saml2": {
            "description": "SAML2 SSO settings, used only when authentication_method is saml2",
            "type": "object",
            "properties": {
                "idp_metadata_url": {
                    "description": "URL of the SAML2 Identity Provider metadata",
                    "type": "string"
                },
                "identity_attribute": {
                    "description": "SAML attribute mapping to the username (e.g. uid, eppn)",
                    "type": "string"
                },
                "login_button_label": {
                    "description": "Optional label shown on the CTI SSO login button",
                    "type": "string"
                },
                "user_allowlist": {
                    "description": "Optional list of usernames allowed to log in via SSO",
                    "type": "string"
                },
                "identity_value_regex": {
                    "description": "Optional regex the SSO identity value must match",
                    "type": "string"
                },
                "idp_signing_cert": {
                    "description": "Optional PEM certificate verifying the IdP metadata signature",
                    "type": "string"
                },
                "jwt_timeout_hours": {
                    "description": "Optional JWT lifetime in hours (default 336)",
                    "type": ["integer", "string"]
                }
            }
        },
        "oidc": {
            "description": "OIDC SSO settings, used only when authentication_method is oidc",
            "type": "object",
            "properties": {
                "issuer_url": {
                    "description": "OIDC issuer URL (discovery base)",
                    "type": "string"
                },
                "client_id": {
                    "description": "OIDC client id registered on the provider",
                    "type": "string"
                },
                "client_secret": {
                    "description": "OIDC client secret (stored in passwords.env)",
                    "type": "string"
                },
                "login_button_label": {
                    "description": "Optional label shown on the CTI SSO login button",
                    "type": "string"
                },
                "idp_name": {
                    "description": "Optional provider name shown under the SSO login button",
                    "type": "string"
                }
            }
        }
    }
}
