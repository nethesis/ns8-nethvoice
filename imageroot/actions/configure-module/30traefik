"""
Main routes (without paths) are configured in step 15configure_main_routes
to ensure DNS checks happen before start the actual module configuration.
"""

import os

import agent

# Configure Traefik to route "/tancredi" path requests to the webapp service
agent.set_route({
    'instance': os.environ['MODULE_ID'] + '-tancredi',
    'url':  'http://127.0.0.1:' + os.environ["TANCREDIPORT"] + '/tancredi',
    'http2https':  False,
    'host': os.environ["NETHVOICE_HOST"],
    'path': '/tancredi',
})

# Configure Traefik to route "/provisioning" path requests to get phones configuration
agent.set_route({
    'instance': os.environ['MODULE_ID'] + '-provisioning',
    'url':  'http://127.0.0.1:' + os.environ["TANCREDIPORT"] + '/provisioning',
    'http2https':  False,
    'host': os.environ["NETHVOICE_HOST"],
    'path': '/provisioning',
})

## Set up Janus on same host
agent.set_route({
    'instance': os.environ['MODULE_ID'] + '-janus',
    'url':  'http://127.0.0.1:' + os.environ["JANUS_TRANSPORT_PORT"],
    'http2https':  os.environ["TRAEFIK_HTTP2HTTPS"] == "true",
    'host': os.environ["NETHCTI_UI_HOST"],
    'path': '/janus',
    'headers': {
        'response': {
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Credentials': "true",
            'Access-Control-Allow-Headers': '*'
        }
    }
})

# SIP over WebSocket clients
agent.set_route({
    'instance': os.environ['MODULE_ID'] + '-asterisk-ws',
    'url':  'http://127.0.0.1:' + os.environ["ASTERISK_WS_PORT"],
    'http2https':  os.environ["TRAEFIK_HTTP2HTTPS"] == "true",
    'host': os.environ["NETHVOICE_HOST"],
    'path': '/ws',
})

# CTI Wizard
# Configure middleware API route on NETHVOICE_HOST
agent.set_route({
    'instance': os.environ['MODULE_ID'] + '-middleware-server-api',
    'url':  'http://127.0.0.1:' + os.environ["NETHVOICE_MIDDLEWARE_PORT"],
    'http2https':  os.environ["TRAEFIK_HTTP2HTTPS"] == "true",
    'host': os.environ["NETHVOICE_HOST"],
    'path': '/api',
    'strip_prefix': True,
    'headers': {
        'response': {
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Credentials': "true",
            'Access-Control-Allow-Headers': '*'
        }
    }
})

# CTI client
# Configure middleware API route on NETHCTI_UI_HOST 
agent.set_route({
    'instance': os.environ['MODULE_ID'] + '-middleware-cti-server-api',
    'url':  'http://127.0.0.1:' + os.environ["NETHVOICE_MIDDLEWARE_PORT"],
    'http2https':  os.environ["TRAEFIK_HTTP2HTTPS"] == "true",
    'host': os.environ["NETHCTI_UI_HOST"],
    'path': '/api',
    'strip_prefix': True,
    'headers': {
        'response': {
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Credentials': "true",
            'Access-Control-Allow-Headers': '*'
        }
    }
})
