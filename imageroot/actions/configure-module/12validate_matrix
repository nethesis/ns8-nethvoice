#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import agent


def validate_settings(env, request, identity=None, wizard_complete=True):
    active = request.get('matrix_enabled', env.get('NETHVOICE_MATRIX_ENABLED', 'False') == 'True')
    host = request.get('matrix_host', env.get('NETHVOICE_MATRIX_HOST', ''))
    error = None
    if identity and host != identity['server_name']:
        error = 'matrix_host_immutable'
    elif active and not host:
        error = 'matrix_host_required'
    elif host and (len(host) > 253 or not re.fullmatch(
            r'(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+'
            r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?', host)):
        error = 'matrix_host_invalid'
    elif active and host in (request.get('nethvoice_host', env.get('NETHVOICE_HOST')),
                             request.get('nethcti_ui_host', env.get('NETHCTI_UI_HOST'))):
        error = 'matrix_host_conflict'
    if error:
        return [{'field': 'matrix_host', 'parameter': 'matrix_host',
                 'value': host, 'error': error}]
    if active and not wizard_complete:
        return [{'field': 'matrix_enabled', 'parameter': 'matrix_enabled',
                 'value': active, 'error': 'matrix_setup_required'}]
    return []


def main():
    request = json.load(sys.stdin)
    env = {**os.environ, **agent.read_envfile('environment')}
    identity_path = Path(os.environ['AGENT_STATE_DIR']) / 'matrix/identity.json'
    identity = json.loads(identity_path.read_text()) if identity_path.exists() else None
    complete = True
    if request.get('matrix_enabled', env.get('NETHVOICE_MATRIX_ENABLED', 'False') == 'True'):
        passwords = agent.read_envfile('passwords.env')
        # Pass the DB credential through the container environment, never an argv
        # password option that would be visible in journal/process diagnostics.
        result = subprocess.run(['podman', 'exec', '--env', 'MYSQL_PWD',
                                 'mariadb', 'mysql', '-u', 'root', '-h', '127.0.0.1',
                                 '-P', env['NETHVOICE_MARIADB_PORT'], 'asterisk', '-BNe',
                                 'select step from rest_wizard'],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10,
                                env={**os.environ, 'MYSQL_PWD': passwords['MARIADB_ROOT_PASSWORD']})
        try:
            complete = result.returncode == 0 and int(result.stdout.strip()) >= 10
        except ValueError:
            complete = False
    errors = validate_settings(env, request, identity, complete)
    if errors:
        agent.set_status('validation-failed')
        json.dump(errors, sys.stdout)
        sys.exit(3)


if __name__ == "__main__":
    main()
