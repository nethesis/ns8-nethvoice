"""Configure voice-agent ports, credentials and the public webhook route."""
import os
import re
import secrets
import sys
import agent

env = agent.read_envfile('environment')
if 'VOICE_AGENT_MONITORING_RETENTION_DAYS' not in env:
    agent.set_env('VOICE_AGENT_MONITORING_RETENTION_DAYS', '90')
    env['VOICE_AGENT_MONITORING_RETENTION_DAYS'] = '90'
def allocate_agent_ports(env):
    names = ('VOICE_AGENT_HTTP_PORT', 'NETHVOICE_RECIPIENT_SERVICE_PORT', 'VOICE_AGENT_CHAT_PORT')
    occupied = {str(value) for key, value in env.items()
                if key not in names and re.search(r'PORT\d*$', key)}
    missing = []
    for name in names:
        value = str(env.get(name, ''))
        if value.isdecimal() and 0 < int(value) <= 65535 and value not in occupied:
            occupied.add(value)
        else:
            missing.append(name)
    if not missing:
        return
    reserved = re.fullmatch(r'(\d+)-(\d+)', env.get('TCP_PORTS_RANGE', ''))
    ports = {}
    for name in missing:
        if reserved:
            candidate = int(reserved[1]) + 42 + names.index(name)
            if candidate <= int(reserved[2]) and str(candidate) not in occupied:
                ports[name] = str(candidate)
    extra = [name for name in missing if name not in ports]
    if extra:
        first, last = agent.allocate_ports(len(extra), 'tcp', keep_existing=True)
        if last - first + 1 != len(extra):
            raise RuntimeError('Unexpected TCP allocation size')
        ports.update({name: str(first + offset) for offset, name in enumerate(extra)})
    agent.mset_env(ports)
    env.update(ports)


if '--secrets-only' not in sys.argv:
    allocate_agent_ports(env)
passwords = agent.read_envfile('passwords.env')
for name in ('SATELLITE_AGENT_CONFIG_KEY', 'VOICE_AGENT_RUNTIME_TOKEN', 'VOICE_AGENT_CONFIG_PASSWORD', 'VOICE_AGENT_MONITOR_PASSWORD', 'VOICE_AGENT_RECIPIENT_TOKEN', 'VOICE_AGENT_CHAT_TOKEN'):
    if not passwords.get(name):
        passwords[name] = secrets.token_urlsafe(32)
agent.write_envfile('passwords.env', passwords)
os.chmod('passwords.env', 0o600)
runtime_keys = ('SATELLITE_AGENT_CONFIG_KEY', 'VOICE_AGENT_RUNTIME_TOKEN',
                'VOICE_AGENT_CONFIG_PASSWORD', 'VOICE_AGENT_MONITOR_PASSWORD',
                'SATELLITE_ARI_PASSWORD', 'VOICE_AGENT_RECIPIENT_TOKEN', 'VOICE_AGENT_CHAT_TOKEN')
runtime_env = {name: passwords[name] for name in runtime_keys}
for name in ('OPENAI_API_KEY', 'XAI_API_KEY', 'GROK_API_KEY',
             'DEEPGRAM_API_KEY', 'SATELLITE_MQTT_PASSWORD'):
    value = passwords.get(name) or os.environ.get(name)
    if value:
        runtime_env[name] = value
runtime_env['VOICE_AGENT_MONITORING_RETENTION_DAYS'] = env.get('VOICE_AGENT_MONITORING_RETENTION_DAYS', '90')
runtime_env['VOICE_AGENT_LIVE_WS_MAX_CALLS'] = env.get('VOICE_AGENT_LIVE_WS_MAX_CALLS', '4')
runtime_env['API_TOKEN'] = passwords['SATELLITE_API_TOKEN']
runtime_env['PGVECTOR_PASSWORD'] = passwords['SATELLITE_PGSQL_PASSWORD']
for name, port in (('RECIPIENT', 'NETHVOICE_RECIPIENT_SERVICE_PORT'), ('CHAT', 'VOICE_AGENT_CHAT_PORT')):
    if env.get(port):
        runtime_env['VOICE_AGENT_' + name + '_URL'] = 'http://127.0.0.1:' + str(env[port])
agent.write_envfile('satellite.env', runtime_env)
os.chmod('satellite.env', 0o600)
# Forward exactly the public provider prefix to a loopback-only listener.
env = agent.read_envfile('environment')
if '--secrets-only' in sys.argv:
    sys.exit(0)
agent.set_route({'instance': os.environ['MODULE_ID'] + '-voice-agent-webhooks',
    'host': env['NETHVOICE_HOST'], 'path': '/satellite-webhooks',
    'url': 'http://127.0.0.1:' + env['VOICE_AGENT_HTTP_PORT'], 'strip_prefix': False,
    'http2https': True})
