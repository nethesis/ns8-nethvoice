"""Apply changed Satellite configuration after active calls finish."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

import agent


def systemctl(*args):
    run('systemctl', '--user', *args)


def run(*args):
    subprocess.run(list(args), check=True, stdout=sys.stderr)


module_dir = Path(os.environ['AGENT_INSTALL_DIR'])
# Keep every configuration path on the same least-privilege runtime projection.
run(str(module_dir / 'actions/configure-module/29voice_agents'), '--secrets-only')
unit = (module_dir / 'systemd/user/satellite.service').read_text()
settings = {name: os.getenv(name, '') for name in re.findall(r'\$\{([A-Z0-9_]+)\}', unit)}
image = subprocess.run(['podman', 'image', 'inspect', '--format', '{{.Id}}',
                        os.environ['NETHVOICE_SATELLITE_IMAGE']],
                       capture_output=True, text=True, check=True).stdout.strip()
fingerprint = hashlib.sha256(unit.encode() + json.dumps(settings, sort_keys=True).encode() +
                             image.encode() + Path('satellite.env').read_bytes()).hexdigest()
previous = Path('satellite-runtime.sha256')
active = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', 'satellite.service'], check=False)
changed = (not previous.exists() or previous.read_text().strip() != fingerprint
           or active.returncode != 0)
if changed:
    # A settings save must never tear down calls. Failure to query Asterisk is also
    # a refusal to restart, rather than an assumption that it is idle.
    run('restart-services-when-convenient', '--wait-only')
    legacy = subprocess.run(['systemctl', '--user', 'show', 'voice-agent.service',
                             '--property=LoadState', '--value'],
                            capture_output=True, text=True, check=False)
    if legacy.stdout.strip() == 'loaded':
        systemctl('disable', '--now', 'voice-agent.service')
    run('podman', 'rm', '--ignore', '-f', 'voice-agent')
    systemctl('stop', 'satellite.service')
    # Provision accounts only on a configuration change, outside routine restarts.
    run('podman', 'exec', 'freepbx', 'php', '/var/www/html/freepbx/rest/lib/agents/install-runtime.php')
    transcription = any(os.getenv(name, '').lower() == 'true' for name in (
        'SATELLITE_CALL_TRANSCRIPTION_ENABLED', 'SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED'))
    if transcription:
        systemctl('enable', '--now', 'satellite-pgsql.service', 'satellite-mqtt.service')
    else:
        systemctl('disable', '--now', 'satellite-recordings-cleanup.timer')
        systemctl('stop', 'satellite-recordings-cleanup.service')
        systemctl('disable', '--now', 'satellite-mqtt.service')
        # Preserve PostgreSQL for reads of historical transcripts.
    systemctl('enable', 'satellite.service')
    systemctl('start', 'satellite.service')
    if transcription:
        systemctl('disable', 'satellite-recordings-cleanup.service')
        systemctl('enable', '--now', 'satellite-recordings-cleanup.timer')
        systemctl('start', 'satellite-recordings-cleanup.service')
    temporary = previous.with_suffix('.tmp')
    temporary.write_text(fingerprint + '\n')
    temporary.chmod(0o600)
    temporary.replace(previous)

for service in ('freepbx.service', 'nethcti-server.service', 'nethcti-ui.service'):
    systemctl('try-restart', service)
