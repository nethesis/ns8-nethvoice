import os
import subprocess

call_enabled = os.getenv('SATELLITE_CALL_TRANSCRIPTION_ENABLED', 'False')
vm_enabled = os.getenv('SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED', 'False')

# History remains available even on instances that never enabled transcription.
subprocess.run(["systemctl", "--user", "enable", "--now", "satellite-pgsql.service"], check=False)
subprocess.run(["systemctl", "--user", "enable", "--now", "satellite-monitoring-retention.timer"], check=True)

if call_enabled == 'True' or vm_enabled == 'True':
    # Enable and restart satellite services
    subprocess.run(["systemctl", "--user", "enable", "satellite-mqtt.service"], check=True)
    subprocess.run(["systemctl", "--user", "restart", "satellite-mqtt.service"], check=True)


    subprocess.run(["systemctl", "--user", "disable", "satellite-recordings-cleanup.service"], check=False)
    subprocess.run(["systemctl", "--user", "enable", "satellite-recordings-cleanup.timer"], check=True)
    subprocess.run(["systemctl", "--user", "start", "satellite-recordings-cleanup.service"], check=True)

    subprocess.run(["systemctl", "--user", "try-restart", "freepbx.service"], check=True)
    subprocess.run(["systemctl", "--user", "try-restart", "nethcti-server.service"], check=True)
    subprocess.run(["systemctl", "--user", "try-restart", "nethcti-ui.service"], check=True)

elif call_enabled == 'False' and vm_enabled == 'False':
    # Stop only the transcription dependencies; the Agent runtime stays up.
    subprocess.run(["systemctl", "--user", "stop", "satellite-mqtt.service"], check=False)
    subprocess.run(["systemctl", "--user", "disable", "satellite-mqtt.service"], check=False)

    # Do NOT stop satellite-pgsql: stopping the live/write path (satellite + mqtt)
    # already prevents new transcripts/summaries from being created, while keeping
    # the database up so users can still consult the ones generated in the past.
    # The middleware reads them through a direct connection to this DB.

    subprocess.run(["systemctl", "--user", "stop", "satellite-recordings-cleanup.timer"], check=False)
    subprocess.run(["systemctl", "--user", "disable", "satellite-recordings-cleanup.timer"], check=False)
    subprocess.run(["systemctl", "--user", "stop", "satellite-recordings-cleanup.service"], check=False)
    subprocess.run(["systemctl", "--user", "disable", "satellite-recordings-cleanup.service"], check=False)

    subprocess.run(["systemctl", "--user", "try-restart", "freepbx.service"], check=True)
    subprocess.run(["systemctl", "--user", "try-restart", "nethcti-server.service"], check=True)
    subprocess.run(["systemctl", "--user", "try-restart", "nethcti-ui.service"], check=True)

# The Agent API uses the same Satellite process regardless of transcription.
# Restart it after any toggle change to pass the current transcription flag.
subprocess.run(["systemctl", "--user", "enable", "satellite.service"], check=True)
subprocess.run(["systemctl", "--user", "restart", "satellite.service"], check=True)
subprocess.run(["systemctl", "--user", "enable", "--now", "satellite-agent-sync.timer"], check=True)
subprocess.run(["systemctl", "--user", "start", "satellite-agent-sync.service"], check=False)
