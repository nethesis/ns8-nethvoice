import subprocess
import sys

# The shared service refreshes its filtered credentials on every start.
subprocess.run(['manage-satellite'], check=True, stdout=sys.stderr)
for service in ('freepbx.service', 'nethcti-server.service', 'nethcti-ui.service'):
    subprocess.run(['systemctl', '--user', 'try-restart', service], check=True, stdout=sys.stderr)
