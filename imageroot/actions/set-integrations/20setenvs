import json
import sys
import os
from pathlib import Path

import agent

request = json.load(sys.stdin)

env = agent.read_envfile("environment")
for key in ("satellite_call_transcription_enabled", "satellite_voicemail_transcription_enabled",
            "satellite_call_summary_enabled"):
    if key in request and request[key] != (env.get(key.upper(), '').lower() == 'true'):
        Path('transcription-refresh.pending').touch(mode=0o600)
if "voice_agent_enabled" in request:
    agent.set_env("VOICE_AGENT_ENABLED", "true" if request["voice_agent_enabled"] else "false")
if "chat_enabled" in request and request["chat_enabled"] != (env.get("CHAT_ENABLED") == "true"):
    Path('cti-chat-refresh.pending').touch(mode=0o600)
if "satellite_call_transcription_enabled" in request:
    agent.set_env("SATELLITE_CALL_TRANSCRIPTION_ENABLED", request["satellite_call_transcription_enabled"])
if "satellite_voicemail_transcription_enabled" in request:
    agent.set_env("SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED", request["satellite_voicemail_transcription_enabled"])
if "satellite_call_summary_enabled" in request:
    agent.set_env("SATELLITE_CALL_SUMMARY_ENABLED", request["satellite_call_summary_enabled"])
if "chat_enabled" in request:
    agent.set_env("CHAT_ENABLED", "true" if request["chat_enabled"] else "false")
for key in ("chat_retention_days", "chat_upload_quota_mb", "chat_upload_max_file_mb"):
    if key in request:
        agent.set_env(key.upper(), str(request[key]))

# read from  the passwords.env file
passwordsfile = agent.read_envfile("passwords.env")

# set DEEPGRAM_API_KEY and OPENAI_API_KEY if present in the request
if 'deepgram_api_key' in request:
    passwordsfile['DEEPGRAM_API_KEY'] = request['deepgram_api_key']

if 'openai_api_key' in request:
    passwordsfile['OPENAI_API_KEY'] = request['openai_api_key']

# write the passwords.env file
agent.write_envfile("passwords.env", passwordsfile)
