# NethVoice chat: routes and units follow CHAT_ENABLED.
set -e
if [[ -f cti-chat-refresh.pending ]]; then
    "${AGENT_INSTALL_DIR}/actions/configure-module/45chat_routes" </dev/null
fi
if [[ -f cti-chat-refresh.pending || -f chat-config-refresh.pending ]]; then
    "${AGENT_INSTALL_DIR}/actions/configure-module/46chat" </dev/null
    rm -f chat-config-refresh.pending
fi
if [[ -f cti-chat-refresh.pending ]]; then
    systemctl --user try-restart nethcti-ui.service nethcti-server.service
    rm -f cti-chat-refresh.pending
fi
