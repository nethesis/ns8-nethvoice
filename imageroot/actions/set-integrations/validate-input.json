{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Set nethvoice integrations",
    "$id": "http://nethserver.org/json-schema/task/input/nethvoice/set-integrations",
    "description": "Set nethvoice integrations",
    "type": "object",
    "properties": {
        "satellite_call_transcription_enabled": {
            "description": "Enable real-time call transcription",
            "type": "boolean"
        },
        "satellite_voicemail_transcription_enabled": {
            "description": "Enable voicemail transcription",
            "type": "boolean"
        },
        "satellite_call_summary_enabled": {
            "description": "Enable call summary generation",
            "type": "boolean"
        },
        "chat_enabled": {
            "description": "Enable the NethVoice chat",
            "type": "boolean"
        },
        "chat_retention_days": {
            "description": "Days chat messages and attachments are kept",
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
        },
        "chat_upload_quota_mb": {
            "description": "Chat attachments space per user, in MB",
            "type": "integer",
            "minimum": 10,
            "maximum": 100000
        },
        "chat_upload_max_file_mb": {
            "description": "Largest chat attachment, in MB",
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
        },
        "deepgram_api_key": {
            "description": "Deepgram API key for real-time call and voicemail transcription",
            "type": "string",
            "anyOf": [
                {
                    "pattern": "^[a-zA-Z0-9]+$"
                },
                {
                    "pattern": "^$"
                }
            ]
        },
        "openai_api_key": {
            "description": "OpenAI API key for call and voicemail summarization",
            "type": "string",
            "anyOf": [
                {
                    "pattern": "^[a-zA-Z0-9\\-_]+$"
                },
                {
                    "pattern": "^$"
                }
            ]
        }
    },
    "additionalProperties": false
}
