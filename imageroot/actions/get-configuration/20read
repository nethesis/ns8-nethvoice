    'user_domain': os.getenv('USER_DOMAIN', ''),
    'reports_international_prefix': os.getenv('REPORTS_INTERNATIONAL_PREFIX', ''),
    'subscription_systemid': os.getenv('SUBSCRIPTION_SYSTEMID', ''),
    # Authentication method: how users prove identity (independent from user_domain,
    # which stays the source of user records). Defaults to direct password.
    'authentication_method': os.getenv('AUTHENTICATION_METHOD', 'password'),
    'saml2': {
        'idp_metadata_url': os.getenv('SAML2_IDP_METADATA_URL', ''),
        'identity_attribute': os.getenv('SAML2_IDENTITY_ATTRIBUTE', 'uid'),
        'login_button_label': os.getenv('SAML2_LOGIN_BUTTON_LABEL', ''),
        'user_allowlist': os.getenv('SAML2_USER_ALLOWLIST', ''),
        'identity_value_regex': os.getenv('SAML2_IDENTITY_VALUE_REGEX', ''),
