import base64
import json
import sys
import os

import agent

config = {
    'nethvoice_host': os.getenv('NETHVOICE_HOST', ''),
    'nethcti_ui_host': os.getenv('NETHCTI_UI_HOST', ''),
    'lets_encrypt': (agent.get_route(os.environ['MODULE_ID'] + '-wizard') or {}).get('lets_encrypt', False),
