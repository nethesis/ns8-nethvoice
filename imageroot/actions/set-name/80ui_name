# Show the new instance name in the administration UI, after the core step
# stored it in Redis. A failure must not stop the action.

import json
import subprocess
import sys

request = json.load(sys.stdin)

if subprocess.run(["sync-ui-name", request["name"]], check=False).returncode != 0:
    print("Warning: instance name not updated in the administration UI", file=sys.stderr)
