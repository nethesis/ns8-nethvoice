import json
import sys

import agent
import admin_group_prefix

request = json.load(sys.stdin)
prefix = request["prefix"]

if admin_group_prefix.claimed_by_others(prefix):
    agent.set_status("validation-failed")
    json.dump([{"field": "prefix", "parameter": "prefix", "value": prefix, "error": "prefix_already_used"}], fp=sys.stdout)
    sys.exit(2)

if admin_group_prefix.read_environment().get(admin_group_prefix.PREFIX_VARIABLE, "") != prefix:
    agent.set_env(admin_group_prefix.PREFIX_VARIABLE, prefix)
    agent.run_helper("systemctl", "--user", "try-restart", "freepbx.service").check_returncode()
