import agent


# Cleanup the environment
agent.unset_env('NETHVOICE_USER_PORTAL_USERNAME')
agent.mset_env({
    'NETHVOICE_USER_PORTAL_URL': '',
    'NETHVOICE_USER_PORTAL_NODE': '',
})
agent.unset_env('RESTART_SERVICES')
# per-install SSO secrets (stored in passwords.env): drop them so the clone
# regenerates its own at configure
passwords = agent.read_envfile('passwords.env')
if any(k in passwords for k in ('NETHCTI_SSO_TRUSTED_SECRET', 'NETHCTI_SSO_TOKEN_KEY',
                                'NETHCTI_SSO_PROXY_SECRET', 'NETHCTI_SSO_OIDC_COOKIE_SECRET')):
    for k in ('NETHCTI_SSO_TRUSTED_SECRET', 'NETHCTI_SSO_TOKEN_KEY',
              'NETHCTI_SSO_PROXY_SECRET', 'NETHCTI_SSO_OIDC_COOKIE_SECRET'):
        passwords.pop(k, None)
    agent.write_envfile('passwords.env', passwords)
