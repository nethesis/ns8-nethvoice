import agent
import os
import subprocess
import sys

# old and new password for MARIADB_ROOT_PASSWORD
MARIADB_ROOT_PASSWORD_NEW = agent.read_envfile("passwords.env")['MARIADB_ROOT_PASSWORD']
MARIADB_ROOT_PASSWORD_OLD = agent.read_envfile("passwords.old")['MARIADB_ROOT_PASSWORD']

# Set new mariadb root password
SQL_QUERY = f"""
ALTER USER 'root'@'localhost' IDENTIFIED BY '{MARIADB_ROOT_PASSWORD_NEW}';
ALTER USER 'root'@'%' IDENTIFIED BY '{MARIADB_ROOT_PASSWORD_NEW}';
DROP USER IF EXISTS 'voice_agent_config'@'127.0.0.1', 'voice_agent_config'@'localhost',
                    'voice_agent_monitor'@'127.0.0.1', 'voice_agent_monitor'@'localhost';
FLUSH PRIVILEGES;
"""
subprocess.run('podman exec -i --env MYSQL_PWD mariadb mariadb -u root'.split(), env=dict(os.environ, MYSQL_PWD=MARIADB_ROOT_PASSWORD_OLD), input=SQL_QUERY, text=True, stdout=sys.stderr, check=True)

# A copied signing secret keeps its ciphertext, but verification belongs to
# the source host. Restrict this write to the versioned preview layout.
preview_webhook_column = """
SELECT COUNT(*) FROM information_schema.columns WHERE table_schema='asterisk'
 AND table_name='voice_agent_bindings' AND column_name='webhook_verified_at'
 AND EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema='asterisk'
             AND table_name='voice_agent_preview_schema')
"""
sql = ['podman', 'exec', '-i', '--env', 'MYSQL_PWD', 'mariadb', 'mariadb', '-u', 'root', '-BN']
credentials = dict(os.environ, MYSQL_PWD=MARIADB_ROOT_PASSWORD_NEW)
result = subprocess.run(sql, env=credentials, input=preview_webhook_column + ';',
                        capture_output=True, text=True, check=True)
if result.stdout.strip() == '1':
    subprocess.run(sql, env=credentials,
                   input='UPDATE asterisk.voice_agent_bindings SET webhook_verified_at=NULL;',
                   text=True, check=True)

# Set the new passwords
agent.run_helper(*f'podman exec --env-file=passwords.env mariadb /docker-entrypoint-initdb.d/90_users.sh'.split()).check_returncode()
