{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Get port migration status",
  "$id": "http://nethserver.org/json-schema/task/output/nethvoice/get-port-migration-status",
  "description": "Old -> new mapping of the client-facing service ports after the last update.",
  "examples": [
    {
      "migration": [
        {
          "service": "Asterisk SIP UDP",
          "protocol": "udp",
          "old": "20067",
          "new": "26004"
        },
        {
          "service": "Asterisk RTP",
          "protocol": "udp",
          "old": "20002-21001",
          "new": "25004-26003"
        }
      ],
      "seen": false
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "migration",
    "seen"
  ],
  "properties": {
    "migration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "protocol",
          "old",
          "new"
        ],
        "properties": {
          "service": {
            "type": "string",
            "description": "Human-readable service label."
          },
          "protocol": {
            "type": "string",
            "description": "Transport protocol."
          },
          "old": {
            "type": "string",
            "description": "Previous port or range."
          },
          "new": {
            "type": "string",
            "description": "New port or range."
          }
        }
      }
    },
    "seen": {
      "type": "boolean",
      "description": "Whether the admin already dismissed the migration notice."
    }
  }
}