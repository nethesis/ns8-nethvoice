import os

import agent

# Authoritative public-firewall port set for this instance. Applied with
# replace_ports=True so it is the single source of truth on both fresh install
# and update/migration: re-running it drops any stale entry (e.g. an old RTP
# range left over from a previous port allocation) and reopens exactly this
# list. The migration reuses this action via update-module.d/21firewall_ports.
#
# SIP is fronted by the nethvoice-proxy, so the Asterisk SIP UDP port is NOT
# exposed here (external SIP reaches the proxy, not the instance); the Satellite
# RTP port is internal as well. IAX is kept for backward compatibility (matches
# the pre-existing behaviour).
agent.add_public_service(os.environ['MODULE_ID'], [
    os.environ['NETHCTI_TLS_PORT']+"/tcp", # NethCTI TLS (Nethifier)
    os.environ['JANUS_RTPSTART']+"-"+os.environ['JANUS_RTPEND']+"/udp", # Janus
    os.environ['ASTERISK_IAX_PORT']+"/udp", # Asterisk IAX
    os.environ['PHONEBOOK_LDAP_PORT']+"/tcp", # Phonebook LDAPS
    os.environ['ASTERISK_RECORDING_SFTP_PORT']+"/tcp", # Asterisk recordings SFTP
    os.environ['ASTERISK_WSS_PORT']+"/tcp", # Asterisk WSS
    os.environ['ASTERISK_RTPSTART']+"-"+os.environ['ASTERISK_RTPEND']+"/udp", # Asterisk RTP for WSS
], replace_ports=True)

# Ignore exit code
