{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get nethvoice integrations",
    "$id": "http://nethserver.org/json-schema/task/output/nethvoice/get-integrations",
    "description": "Get nethvoice integrations",
    "examples": [
        {
            "satellite_call_transcription_enabled": true,
            "satellite_voicemail_transcription_enabled": false,
            "satellite_call_summary_enabled": true,
            "deepgram_api_key": "your_deepgram_api_key",
            "openai_api_key": "your_openai_api_key"
        },
        {
            "satellite_call_transcription_enabled": false,
            "satellite_voicemail_transcription_enabled": false,
            "satellite_call_summary_enabled": false,
            "deepgram_api_key": "",
            "openai_api_key": ""
        }
    ],
    "type": "object",
    "required": [
        "satellite_call_transcription_enabled",
        "satellite_voicemail_transcription_enabled",
        "satellite_call_summary_enabled",
        "deepgram_api_key",
        "openai_api_key"
    ],
    "properties": {
        "voice_agent_enabled": {"type": "boolean"},
        "satellite_apply_status": {"enum": ["applied", "pending", "failed"]},
        "satellite_apply_error": {"enum": [null, "apply_failed", "port_allocation_failed", "unsupported_development_database",
                                           "runtime_initialization_failed", "voice_agent_runtime_not_ready"]},
        "inherited_agents": {"type": ["array", "null"], "items": {"type": "string"}},
        "satellite_call_transcription_enabled": {
            "description": "Enable real-time call transcription",
            "type": "boolean"
        },
        "satellite_voicemail_transcription_enabled": {
            "description": "Enable voicemail transcription",
            "type": "boolean"
        },
        "satellite_call_summary_enabled": {
            "description": "Enable call summary generation",
            "type": "boolean"
        },
        "chat_enabled": {
            "description": "Enable the NethVoice chat",
            "type": "boolean"
        },
        "chat_retention_days": {
            "description": "Days chat messages and attachments are kept",
            "type": "integer"
        },
        "chat_upload_quota_mb": {
            "description": "Chat attachments space per user, in MB",
            "type": "integer"
        },
        "chat_upload_max_file_mb": {
            "description": "Largest chat attachment, in MB",
            "type": "integer"
        },
        "deepgram_api_key": {
            "description": "Deepgram API key for real-time call and voicemail transcription",
            "type": "string"
        },
        "openai_api_key": {
            "description": "OpenAI API key for call and voicemail summarization",
            "type": "string"
        }
    },
    "additionalProperties": false
}
