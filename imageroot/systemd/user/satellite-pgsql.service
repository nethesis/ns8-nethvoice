[Unit]
Description=Podman PostgreSQL service for Satellite

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/satellite-pgsql.pid %t/satellite-pgsql.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/satellite-pgsql.pid \
	--cidfile %t/satellite-pgsql.ctr-id --cgroups=no-conmon \
	--replace \
	--detach \
	--name=%N \
	--volume=satellite_pgdata:/var/lib/postgresql/18/docker:Z \
	--volume=satellite_pgsocket:/var/run/postgresql:z \
	--env POSTGRES_PASSWORD=${SATELLITE_PGSQL_PASSWORD} \
	--env POSTGRES_USER=${SATELLITE_PGSQL_USER} \
	--env POSTGRES_DB=${SATELLITE_PGSQL_DB} \
	--env PGPORT=${SATELLITE_PGSQL_PORT} \
	--tz=${TIMEZONE} \
	--network=none \
	--init=false \
	${PGVECTOR_IMAGE} \
	postgres -c listen_addresses=

# Clients connect through the Unix socket in the satellite_pgsocket volume.
# Wait for the final server, not the temporary one the entrypoint runs on the
# same socket while it initializes the database: with --init=false PID 1 is
# postgres only once the entrypoint has started the final server.
ExecStartPost=/usr/bin/podman exec satellite-pgsql sh -c 'until [ "$$(cat /proc/1/comm)" = postgres ] && pg_isready -q -h /var/run/postgresql -p "$$PGPORT" -U "$$POSTGRES_USER" -d "$$POSTGRES_DB"; do sleep 1; done'

ExecStop=/usr/bin/podman stop --ignore --cidfile %t/satellite-pgsql.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/satellite-pgsql.ctr-id
PIDFile=%t/satellite-pgsql.pid
Type=forking

[Install]
WantedBy=default.target
