[Unit]
Description=Satellite voice agents and optional transcription for NethVoice
Wants=mariadb.service freepbx.service
After=mariadb.service freepbx.service satellite-mqtt.service satellite-pgsql.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=5
TimeoutStopSec=45
ExecStartPre=/bin/rm -f %t/satellite.pid %t/satellite.ctr-id
ExecStartPre=runagent configure-voice-agents --secrets-only
ExecStart=runagent /usr/bin/podman run \
    --detach \
    --init \
    --conmon-pidfile=%t/satellite.pid \
    --cidfile=%t/satellite.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --stop-timeout=35 \
    --volume=voice-agent-events:/var/lib/voice-agent:Z,U \
    --env-file=%E/state/satellite.env \
    --env=VOICE_AGENT_ENABLED=true \
    --env=VOICE_AGENT_EVENT_DIR=/var/lib/voice-agent \
    --env=VOICE_AGENT_HTTP_HOST=127.0.0.1 \
    --env=VOICE_AGENT_HTTP_PORT=${VOICE_AGENT_HTTP_PORT} \
    --env=VOICE_AGENT_DB_PORT=${NETHVOICE_MARIADB_PORT} \
    --env=SATELLITE_CALL_TRANSCRIPTION_ENABLED=${SATELLITE_CALL_TRANSCRIPTION_ENABLED} \
    --env=SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED=${SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED} \
    --env=ASTERISK_URL="http://127.0.0.1:${ASTERISK_WS_PORT}" \
    --env=ARI_APP=${SATELLITE_ARI_APP} \
    --env=ARI_USERNAME=${SATELLITE_ARI_USERNAME} \
    --env=RTP_PORT=${SATELLITE_RTP_PORT} \
    --env=MQTT_URL="mqtt://127.0.0.1:${SATELLITE_MQTT_PORT}" \
    --env=MQTT_TOPIC_PREFIX=satellite \
    --env=LOG_LEVEL=${SATELLITE_LOG_LEVEL} \
    --env=MQTT_USERNAME=${SATELLITE_MQTT_USERNAME} \
    --env=HTTP_PORT=${SATELLITE_HTTP_PORT} \
    --env=HTTP_HOST=127.0.0.1 \
    --env=PGVECTOR_HOST=127.0.0.1 \
    --env=PGVECTOR_PORT=${SATELLITE_PGSQL_PORT} \
    --env=PGVECTOR_DATABASE=${SATELLITE_PGSQL_DB} \
    --env=PGVECTOR_USER=${SATELLITE_PGSQL_USER} \
    --tz=${TIMEZONE} \
    --network=host \
    ${NETHVOICE_SATELLITE_IMAGE}

ExecStop=/usr/bin/podman stop --ignore --cidfile %t/satellite.ctr-id -t 35
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/satellite.ctr-id
PIDFile=%t/satellite.pid
Type=forking

[Install]
WantedBy=default.target
