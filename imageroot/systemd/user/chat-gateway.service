# NethVoice chat gateway: push (Web Push, Acrobits PNM) and the Acrobits web services.
[Unit]
Description=NethVoice chat gateway
After=chat-server.service
StartLimitBurst=60

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10s
ExecStartPre=/bin/rm -f %t/chat-gateway.pid %t/chat-gateway.ctr-id
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/chat-gateway.pid \
    --cidfile=%t/chat-gateway.ctr-id \
    --cgroups=no-conmon \
    --log-opt=tag=%u \
    --replace --name=%N \
    --volume=chat-gw:/data:Z \
    --env=CHAT_HOST=chat.internal \
    --env=CHAT_PUBLIC_HOST=${NETHCTI_UI_HOST} \
    --env=CHAT_LISTEN=127.0.0.1:${CHAT_GW_PORT} \
    --env=CHAT_C2S_ADDR=127.0.0.1:${CHAT_C2S_PORT} \
    --env=CHAT_COMPONENT_ADDR=127.0.0.1:${CHAT_COMPONENT_PORT} \
    --env=CHAT_COMPONENT_SECRET \
    --env=CHAT_DEBUG=${CHAT_DEBUG} \
    --env=CHAT_MIDDLEWARE_URL=http://127.0.0.1:${NETHVOICE_MIDDLEWARE_PORT} \
    --env=CHAT_UPLOAD_URL=http://127.0.0.1:${CHAT_HTTP_PORT}/upload \
    --env=CHAT_EJABBERD_API=http://127.0.0.1:${CHAT_HTTP_PORT}/api \
    --env=CHAT_DATA_DIR=/data \
    --network=host \
    --tz=${TIMEZONE} \
    --user=root \
    --entrypoint=/opt/ejabberd/bin/chat-gateway \
    ${NETHVOICE_EJABBERD_IMAGE}
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/chat-gateway.ctr-id
PIDFile=%t/chat-gateway.pid
Type=forking

[Install]
WantedBy=default.target
