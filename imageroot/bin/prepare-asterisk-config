"""Prepare bindings for the next start without reloading the running Asterisk."""
import os
import subprocess
import sys
import time


def main():
    if subprocess.run(
        ['podman', 'exec', 'freepbx', 'true'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0:
        # Match startup's bounded retry for FreePBX's reload lock. Other
        # errors must stop preparation before services are restarted.
        for attempt in range(60):
            result = subprocess.run(
                ['podman', 'exec', '--user', 'asterisk', 'freepbx', 'fwconsole',
                 'reload', '--dont-reload-asterisk', '--no-interaction'],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            )
            print(result.stdout, end='', file=sys.stderr)
            if result.returncode == 0:
                break
            if (result.returncode != 255 or
                    'Process is already running.' not in result.stdout or attempt == 59):
                result.check_returncode()
            print('FreePBX reload is busy, retrying in five seconds', file=sys.stderr)
            time.sleep(5)
        return

    # Restore/clone can carry generated files from another instance. Update
    # only their bindings before first start; FreePBX generates the full config
    # during its normal initialization. Fresh volumes may have no such files.
    subprocess.run(
        ['podman', 'run', '--rm', '-i', '--network=none',
         '--volume=asterisk:/etc/asterisk:z', '--env=ASTERISK_*',
         '--env=ASTMANAGERPORT', '--entrypoint=python3',
         os.environ['NETHVOICE_FREEPBX_IMAGE'], '-'],
        input=r'''
import os
from pathlib import Path
import re

root = Path('/etc/asterisk')
path = root / 'pjsip.transports.conf'
if path.exists():
    sections = re.split(r'(?m)(?=^\[)', path.read_text())
    for i, section in enumerate(sections):
        protocol = re.search(r'(?m)^protocol[ \t]*=[ \t]*(udp|tcp|tls)[ \t]*$', section)
        if protocol:
            key = {'udp': 'ASTERISK_SIP_UDP_PORT', 'tcp': 'ASTERISK_SIP_PORT',
                   'tls': 'ASTERISK_SIPS_PORT'}[protocol[1]]
            sections[i] = re.sub(r'(?m)^(bind[ \t]*=[ \t]*[^\n]+?):[0-9]+[ \t]*$',
                                 lambda m: m[1] + ':' + os.environ[key], section)
    path.write_text(''.join(sections))

for filename, settings in {
    'sip_general_additional.conf': {'bindport': 'ASTERISK_SIP_UDP_PORT'},
    'iax_general_additional.conf': {'bindport': 'ASTERISK_IAX_PORT'},
    'rtp_additional.conf': {'rtpstart': 'ASTERISK_RTPSTART', 'rtpend': 'ASTERISK_RTPEND'},
    'http_additional.conf': {'bindport': 'ASTERISK_WS_PORT'},
    'manager.conf': {'port': 'ASTMANAGERPORT'},
}.items():
    path = root / filename
    if not path.exists():
        continue
    content = path.read_text()
    for setting, key in settings.items():
        content = re.sub(r'(?m)^(' + setting + r'[ \t]*=[ \t]*)[0-9]+[ \t]*$',
                         lambda m: m[1] + os.environ[key], content)
    if filename == 'http_additional.conf':
        content = re.sub(r'(?m)^(tlsbindaddr[ \t]*=[ \t]*[^\n]+):[0-9]+[ \t]*$',
                         lambda m: m[1] + ':' + os.environ['ASTERISK_WSS_PORT'], content)
    path.write_text(content)
''', text=True, check=True, stdout=sys.stderr,
    )


if __name__ == '__main__':
    main()
