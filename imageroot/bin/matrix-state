#!/usr/bin/env python3
"""Logical Matrix database snapshots, restore and clone identity handling."""
import argparse
from contextlib import contextmanager
import gzip
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import time

matrix = runpy.run_path(str(Path(__file__).with_name('matrix-config')))
VOLUMES = ('matrix-postgresql-data', 'matrix-synapse-data', 'matrix2acrobits-data')


def run(*args, **kwargs):
    return subprocess.run(args, check=True, stdout=sys.stderr, **kwargs)


def volume_path(name):
    result = subprocess.run(['podman', 'volume', 'inspect', '--format={{.Mountpoint}}', name],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return Path(result.stdout.strip()) if result.returncode == 0 else None


def volume_file_exists(volume, filename):
    # Rootless container files can be owned by a mapped UID that the module
    # user cannot stat outside Podman's user namespace.
    return subprocess.run(['podman', 'unshare', 'test', '-f', str(volume / filename)],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def database_initialized():
    volume = volume_path('matrix-postgresql-data')
    return bool(volume and subprocess.run(['podman', 'unshare', 'test', '-s', str(volume / 'PG_VERSION')],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0)


def container_running(name):
    result = subprocess.run(['podman', 'inspect', '--format={{.State.Running}}', name],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return result.returncode == 0 and result.stdout.strip() == 'true'


@contextmanager
def paused_chat():
    # Stop writers together so the logical DB and bridge cursor/push snapshot
    # describe the same point in time. Restore only previously active units,
    # including on failure; disabled chat must remain disabled.
    units = ('matrix-synapse.service', 'matrix2acrobits.service')
    active = tuple(unit for unit in units if subprocess.run(
        ['systemctl', '--user', '--quiet', 'is-active', unit],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0)
    try:
        if active:
            run('systemctl', '--user', 'stop', *reversed(active))
        yield
    finally:
        if active:
            run('systemctl', '--user', 'start', *active)


def wait_database(name, env):
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        result = subprocess.run(['podman', 'exec', name, 'psql', '-U', env.get('MATRIX_POSTGRES_USER', 'synapse'),
                                 '-d', env.get('MATRIX_POSTGRES_DB', 'synapse'), '-Atc', 'SELECT 1'],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        if result.returncode == 0:
            return
        time.sleep(1)
    raise RuntimeError('Matrix PostgreSQL snapshot service did not become ready')


@contextmanager
def database(env, passwords):
    """Use the running DB or temporarily serve its volume without networking.

    This works for disabled chat too; disabled units intentionally refuse to
    start, so a backup must not use systemctl to bypass that guard.
    """
    if container_running('matrix-postgresql'):
        yield 'matrix-postgresql'
        return
    name = 'matrix-postgresql-snapshot'
    process_env = {**os.environ, 'POSTGRES_PASSWORD': passwords['MATRIX_POSTGRES_PASSWORD']}
    try:
        run('podman', 'run', '--rm', '--detach', '--name=' + name, '--network=none',
            '--volume=matrix-postgresql-data:/var/lib/postgresql/data:Z',
            '--env=POSTGRES_USER=' + env.get('MATRIX_POSTGRES_USER', 'synapse'),
            '--env=POSTGRES_DB=' + env.get('MATRIX_POSTGRES_DB', 'synapse'),
            '--env=POSTGRES_PASSWORD', '--env=POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C',
            env['POSTGRES_IMAGE'], env=process_env)
        wait_database(name, env)
        yield name
    finally:
        run('podman', 'stop', '--ignore', '-t', '60', name)


def dump_database(destination, name, env):
    temporary = destination.with_name(destination.name + '.tmp')
    process = subprocess.Popen(['podman', 'exec', name, 'pg_dump', '-U', env.get('MATRIX_POSTGRES_USER', 'synapse'),
                                '--format=custom', env.get('MATRIX_POSTGRES_DB', 'synapse')], stdout=subprocess.PIPE)
    try:
        with gzip.open(temporary, 'wb') as stream:
            os.chmod(temporary, 0o600)
            shutil.copyfileobj(process.stdout, stream)
        process.stdout.close()
        if process.wait() != 0:
            raise RuntimeError('Matrix PostgreSQL dump failed')
        temporary.replace(destination)
    finally:
        process.stdout.close()
        if process.poll() is None:
            process.kill()
            process.wait()
        temporary.unlink(missing_ok=True)


def dump_bridge(env):
    volume = volume_path('matrix2acrobits-data')
    if volume is None or not volume_file_exists(volume, 'push.db'):
        return
    if container_running('matrix2acrobits'):
        run('podman', 'exec', 'matrix2acrobits', '/usr/local/bin/matrix2acrobits',
            'backup-db', '--output', '/data/push.backup.db')
    else:
        run('podman', 'run', '--rm', '--network=none', '--userns=keep-id:uid=65532,gid=65532',
            '--volume=matrix2acrobits-data:/data:Z', '--env=PUSH_TOKEN_DB_PATH=/data/push.db',
            env['NETHVOICE_MATRIX2ACROBITS_IMAGE'], 'backup-db', '--output', '/data/push.backup.db')


def restore_database(source, env, passwords):
    with database(env, passwords) as name:
        process = subprocess.Popen(['podman', 'exec', '--interactive', name, 'pg_restore',
                                    '-U', env.get('MATRIX_POSTGRES_USER', 'synapse'),
                                    '--exit-on-error', '--clean', '--if-exists', '--no-owner', '--no-privileges',
                                    '-d', env.get('MATRIX_POSTGRES_DB', 'synapse')], stdin=subprocess.PIPE, stdout=sys.stderr)
        try:
            with gzip.open(source, 'rb') as stream:
                shutil.copyfileobj(stream, process.stdin)
            process.stdin.close()
            if process.wait() != 0:
                raise RuntimeError('Matrix PostgreSQL restore failed')
        finally:
            if not process.stdin.closed:
                process.stdin.close()
            if process.poll() is None:
                process.kill()
                process.wait()
    source.unlink()


def restore_bridge_files(volume):
    """Run only inside podman unshare, where mapped volume files are readable."""
    temporary = volume / 'push.db.restore'
    shutil.copyfile(volume / 'push.backup.db', temporary)
    os.chmod(temporary, 0o600)
    snapshot = (volume / 'push.backup.db').stat()
    os.chown(temporary, snapshot.st_uid, snapshot.st_gid)
    for suffix in ('-wal', '-shm'):
        (volume / ('push.db' + suffix)).unlink(missing_ok=True)
    temporary.replace(volume / 'push.db')


def restore_bridge():
    volume = volume_path('matrix2acrobits-data')
    if volume is None or not volume_file_exists(volume, 'push.backup.db'):
        return
    run('podman', 'unshare', sys.executable, str(Path(__file__).resolve()),
        'restore-bridge-files', str(volume))


def clone_environment(current, source, passwords, old_passwords, replace):
    """Return the settings/secrets appropriate to a move or independent clone."""
    result = dict(passwords)
    if replace:
        for key in matrix['SECRET_NAMES']:
            if key in old_passwords:
                result[key] = old_passwords[key]
        settings = {key: source.get(key, default) for key, default in
                    (('NETHVOICE_MATRIX_ENABLED', 'False'), ('NETHVOICE_MATRIX_HOST', ''))}
    else:
        settings = {'NETHVOICE_MATRIX_ENABLED': 'False', 'NETHVOICE_MATRIX_HOST': ''}
    return settings, result


def filter_startup_units(contents):
    return ' '.join(unit for unit in contents.split() if unit.removesuffix('.service') not in
                    ('matrix-postgresql', 'matrix-synapse', 'matrix2acrobits')) + '\n'


def clone(state, agent, request):
    replace = request.get('replace', False)
    source = agent.read_envfile('environment.clone-module')
    settings, passwords = clone_environment(agent.read_envfile('environment'), source,
                                           agent.read_envfile('passwords.env'), agent.read_envfile('passwords.old'), replace)
    for key, value in settings.items():
        agent.set_env(key, value)
    agent.write_envfile('passwords.env', passwords)
    if not replace:
        # The core later starts units saved by transfer-state. Removing only
        # systemd enablement would not prevent those saved units from starting.
        for filename in ('default-target.clone-module', 'timers-target.clone-module'):
            path = state / filename
            if path.exists():
                matrix['atomic_write'](path, filter_startup_units(path.read_text()))
        for name in VOLUMES:
            if volume_path(name):
                run('podman', 'volume', 'rm', name)
        shutil.rmtree(state / 'matrix', ignore_errors=True)
        (state / 'matrix_postgresql.pg_dump.gz').unlink(missing_ok=True)
    matrix['atomic_write'](state / 'middleware.env', 'NETHVOICE_MATRIX_BASE_URL=' +
                           ('https://' + settings['NETHVOICE_MATRIX_HOST'] if settings['NETHVOICE_MATRIX_ENABLED'] == 'True' else '') + '\n')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('operation', choices=('dump', 'cleanup', 'restore', 'clone', 'restore-bridge-files'))
    parser.add_argument('volume', nargs='?')
    options = parser.parse_args()
    if options.operation == 'restore-bridge-files':
        if not options.volume:
            parser.error('restore-bridge-files requires a volume path')
        restore_bridge_files(Path(options.volume))
        return
    import agent
    state = Path(os.environ.get('AGENT_STATE_DIR', os.getcwd()))
    env = {**os.environ, **agent.read_envfile('environment')}
    if options.operation == 'cleanup':
        (state / 'matrix_postgresql.pg_dump.gz').unlink(missing_ok=True)
        bridge = volume_path('matrix2acrobits-data')
        if bridge:
            run('podman', 'unshare', 'rm', '-f', str(bridge / 'push.backup.db'))
        return
    passwords = agent.read_envfile('passwords.env')
    if options.operation == 'dump':
        with paused_chat():
            if database_initialized():
                with database(env, passwords) as name:
                    dump_database(state / 'matrix_postgresql.pg_dump.gz', name, env)
            dump_bridge(env)
    elif options.operation == 'restore':
        source = state / 'matrix_postgresql.pg_dump.gz'
        if source.exists():
            run('systemctl', '--user', 'stop', *reversed(matrix['SERVICES']))
            restore_database(source, env, passwords)
        restore_bridge()
    else:
        clone(state, agent, json.load(sys.stdin))


if __name__ == '__main__':
    main()
