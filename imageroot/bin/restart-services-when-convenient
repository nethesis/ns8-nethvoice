#!/bin/bash

# Restart services passed as arguments when there are no active calls

set -e

operation=try-restart
if [[ ${1:-} == --stop ]]; then
    operation=stop
    shift
fi
TIMEOUT=10800 # 3h

for SECONDS in $(seq 1 $TIMEOUT); do
    # Check if there are any calls in progress
    CALLS=$(podman exec freepbx asterisk -rx "core show channels" 2>/dev/null | grep "active call" | cut -d" " -f1) || {
        # If the command fails, assume there are no calls
        CALLS=0
    }
    if [[ $CALLS -eq 0 ]]; then
        break
    fi
    # Sleep for 1 second before checking again
    sleep 1
done

# Restart services
echo "Applying $operation to services $* after waiting $SECONDS seconds"
if [[ $operation == stop ]]; then
    # Bound the whole stop transaction, including dependency ordering. A timed
    # out systemctl client must never let the caller proceed to migration.
    timeout --foreground 300 systemctl --user stop "$@"
else
    systemctl --user "$operation" "$@"
fi
