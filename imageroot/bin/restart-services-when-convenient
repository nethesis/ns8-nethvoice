#!/bin/bash

# Restart services passed as arguments when there are no active calls.
# With --wait-only, return as soon as the PBX is idle without restarting.

set -e

TIMEOUT=10800 # 3h
WAIT_ONLY=false

if [[ "${1:-}" == "--wait-only" ]]; then
    WAIT_ONLY=true
    shift
fi

for SECONDS in $(seq 1 $TIMEOUT); do
    # Check if there are any calls in progress
    CALLS=$(podman exec freepbx asterisk -rx "core show channels" 2>/dev/null | grep "active call" | cut -d" " -f1) || {
        # If the command fails, assume there are no calls
        CALLS=0
    }
    if [[ $CALLS -eq 0 ]]; then
        break
    fi
    # Sleep for 1 second before checking again
    sleep 1
done

if $WAIT_ONLY; then
    exit 0
fi

if [[ "$#" -eq 0 ]]; then
    echo "No services specified" >&2
    exit 2
fi

# Restart services
echo "Restarting services $* which was postponed for $SECONDS seconds"
systemctl --user try-restart "$@"
