#!/bin/bash

# Restart services passed as arguments when there are no active calls

set -euo pipefail
exec 1>&2

# Allow a shorter maintenance deadline, never longer than the default 3h.
TIMEOUT=${NETHVOICE_RESTART_TIMEOUT:-10800}
if [[ ! $TIMEOUT =~ ^[0-9]{1,5}$ ]] || ((10#$TIMEOUT < 1 || 10#$TIMEOUT > 10800)); then
    echo "Invalid restart waiting deadline"
    exit 1
fi
DEADLINE=$((SECONDS + 10#$TIMEOUT))

while ((SECONDS < DEADLINE)); do
    # A successful command and exactly one valid summary are required. Never
    # log raw channel output: it can contain communications metadata.
    REMAINING=$((DEADLINE - SECONDS))
    QUERY_TIMEOUT=$((REMAINING < 10 ? REMAINING : 10))
    if OUTPUT=$(timeout "$QUERY_TIMEOUT" podman exec freepbx asterisk -rx "core show channels" 2>/dev/null); then
        mapfile -t COUNTS < <(printf '%s\n' "$OUTPUT" | sed -nE 's/^([0-9]+) active calls?$/\1/p')
        if [[ ${#COUNTS[@]} -eq 1 && ${COUNTS[0]} =~ ^0+$ ]]; then
            echo "Restarting services after a verified zero-call result: $*"
            exec systemctl --user try-restart "$@"
        fi
    fi
    sleep 1
done

echo "Restart refused: no verified zero-call result within ${TIMEOUT}s; services left untouched"
exit 1
