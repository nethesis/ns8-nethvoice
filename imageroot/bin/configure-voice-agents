#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Idempotent Satellite runtime configuration; no provider account writes."""
import os
import secrets
import sys
import agent

env = agent.read_envfile('environment')
if 'VOICE_AGENT_MONITORING_RETENTION_DAYS' not in env:
    agent.set_env('VOICE_AGENT_MONITORING_RETENTION_DAYS', '90')
    env['VOICE_AGENT_MONITORING_RETENTION_DAYS'] = '90'
if '--secrets-only' not in sys.argv and not env.get('VOICE_AGENT_HTTP_PORT'):
    # Fresh installs already own the full declared demand. Reuse the reserved
    # slot on older installations too; allocate only when that slot is absent.
    port_range = (env.get('TCP_PORTS_RANGE') or os.getenv('TCP_PORTS_RANGE', '')).split('-')
    if len(port_range) == 2 and int(port_range[1]) - int(port_range[0]) >= 38:
        port = int(port_range[0]) + 38
    else:
        port = agent.allocate_ports(1, 'tcp', keep_existing=True)[0]
    agent.set_env('VOICE_AGENT_HTTP_PORT', str(port))
passwords = agent.read_envfile('passwords.env')
for name in ('SATELLITE_AGENT_CONFIG_KEY', 'VOICE_AGENT_RUNTIME_TOKEN', 'VOICE_AGENT_CONFIG_PASSWORD', 'VOICE_AGENT_MONITOR_PASSWORD'):
    if not passwords.get(name):
        passwords[name] = secrets.token_urlsafe(32)
agent.write_envfile('passwords.env', passwords)
os.chmod('passwords.env', 0o600)
runtime_keys = ('SATELLITE_AGENT_CONFIG_KEY', 'VOICE_AGENT_RUNTIME_TOKEN',
                'VOICE_AGENT_CONFIG_PASSWORD', 'VOICE_AGENT_MONITOR_PASSWORD',
                'SATELLITE_ARI_PASSWORD')
runtime_env={name: passwords[name] for name in runtime_keys}
for name in ('OPENAI_API_KEY', 'XAI_API_KEY', 'GROK_API_KEY',
             'DEEPGRAM_API_KEY', 'SATELLITE_MQTT_PASSWORD'):
    value=passwords.get(name) or os.environ.get(name)
    if value:
        runtime_env[name]=value
runtime_env['VOICE_AGENT_MONITORING_RETENTION_DAYS'] = env.get('VOICE_AGENT_MONITORING_RETENTION_DAYS', '90')
runtime_env['API_TOKEN'] = passwords['SATELLITE_API_TOKEN']
runtime_env['PGVECTOR_PASSWORD'] = passwords['SATELLITE_PGSQL_PASSWORD']
agent.write_envfile('satellite.env', runtime_env)
os.chmod('satellite.env', 0o600)
# Forward exactly the public provider prefix to a loopback-only listener.
env = agent.read_envfile('environment')
if '--secrets-only' in sys.argv:
    sys.exit(0)
agent.set_route({'instance': os.environ['MODULE_ID'] + '-voice-agent-webhooks',
    'host': env['NETHVOICE_HOST'], 'path': '/satellite-webhooks',
    'url': 'http://127.0.0.1:' + env['VOICE_AGENT_HTTP_PORT'], 'strip_prefix': False,
    'http2https': True})
