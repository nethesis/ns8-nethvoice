#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Apply one coherent credential generation after the current work drains."""
import hashlib
import json
import os
import re
from pathlib import Path
import subprocess
import sys
import time
from urllib.error import URLError
from urllib.request import Request, urlopen

import agent
import agent.tasks

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'pypkg'))
from voice_preview import allocate_agent_ports

PENDING = Path('satellite-apply.pending')
RUNNING = Path('satellite-apply.running')
FAILED = Path('satellite-apply.failed')
PREVIEW = Path('voice-preview')
EFFECTIVE = PREVIEW / 'effective.env'
STATE = Path('satellite-applied.json')
FLAGS = ('SATELLITE_CALL_TRANSCRIPTION_ENABLED', 'SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED',
         'SATELLITE_CALL_SUMMARY_ENABLED')
SECRET_KEYS = ('SATELLITE_AGENT_CONFIG_KEY', 'VOICE_AGENT_CONFIG_PASSWORD', 'VOICE_AGENT_MONITOR_PASSWORD',
               'VOICE_AGENT_RUNTIME_TOKEN', 'VOICE_AGENT_RECIPIENT_TOKEN', 'VOICE_AGENT_CHAT_TOKEN')
# Stable reasons stored in FAILED; anything else is recorded as apply_failed.
INSTALL_ERRORS = ('unsupported_development_database', 'runtime_initialization_failed')
APPLY_ERRORS = ('port_allocation_failed', 'voice_agent_runtime_not_ready') + INSTALL_ERRORS


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def ctl(*args):
    run('systemctl', '--user', *args)


def active(unit):
    return subprocess.run(['systemctl', '--user', 'is-active', '--quiet', unit]).returncode == 0


def enabled(env, name):
    return str(env.get(name, '')).lower() == 'true'


def to_env(values):
    for value in values.values():
        if any(c in str(value) for c in '\r\n\0'):
            raise ValueError('invalid_environment_value')
    return ''.join(f'{k}={v}\n' for k, v in sorted(values.items())).encode()


def write(path, value, php=False):
    temporary = path.with_suffix('.tmp')
    temporary.write_bytes(value)
    if php:
        # The FreePBX image assigns group 991 to the asterisk/Apache identity.
        run('podman', 'unshare', 'chgrp', '991', str(temporary))
        temporary.chmod(0o640)
    temporary.replace(path)


def pbx_idle():
    result = run('podman', 'exec', 'freepbx', 'asterisk', '-rx', 'core show channels count',
                 capture_output=True, text=True)
    match = re.search(r'^(\d+) active calls?$', result.stdout, re.MULTILINE)
    if not match:
        raise RuntimeError('active_call_count_unavailable')
    return int(match[1]) == 0


def wait_for_agents(port, token):
    request = Request(f'http://127.0.0.1:{int(port)}/internal/ready',
                      headers={'Authorization': 'Bearer ' + token})
    deadline = time.monotonic() + 25
    while time.monotonic() < deadline:
        try:
            with urlopen(request, timeout=1) as response:
                if json.load(response).get('voice_calls_enabled') is True:
                    return
        except (OSError, URLError, ValueError):
            pass
        time.sleep(0.5)
    raise RuntimeError('voice_agent_runtime_not_ready')


def apply(*, transcription_only=False):
    env = agent.read_envfile('environment')
    if not env.get('NETHVOICE_HOST'):
        return True
    previous = json.loads(STATE.read_text()) if STATE.exists() else {}
    agents = not transcription_only and enabled(env, 'VOICE_AGENT_ENABLED')
    sip = agents and enabled(env, 'VOICE_AGENT_SIP_LAB_ENABLED')
    transcription = any(enabled(env, name) for name in FLAGS[:2])
    flags = [enabled(env, name) for name in FLAGS]
    needed = agents or transcription
    passwords = agent.read_envfile('passwords.env')
    if agents:
        try:
            allocate_agent_ports(env)
        except Exception as error:
            error.apply_error = 'port_allocation_failed'
            raise
    settings = {'VOICE_AGENT_ENABLED': str(agents).lower(), 'VOICE_AGENT_SIP_LAB_ENABLED': str(sip).lower()}
    if agents:
        settings.update({name: passwords[name] for name in SECRET_KEYS})
        for name in ('VOICE_AGENT_HTTP_PORT', 'NETHVOICE_RECIPIENT_SERVICE_PORT', 'VOICE_AGENT_CHAT_PORT'):
            settings[name] = env[name]
        settings['CHAT_CONSULTATION_LISTEN'] = '127.0.0.1:' + str(env['VOICE_AGENT_CHAT_PORT'])
        settings['OPENAI_API_KEY'] = passwords.get('OPENAI_API_KEY', '')
        settings['VOICE_AGENT_MONITORING_RETENTION_DAYS'] = env.get('VOICE_AGENT_MONITORING_RETENTION_DAYS', '90')
    runtime = dict(settings)
    if needed:
        runtime.update({name: passwords.get(name, '') for name in
                        ('SATELLITE_ARI_PASSWORD', 'SATELLITE_MQTT_PASSWORD', 'OPENAI_API_KEY', 'DEEPGRAM_API_KEY')})
        runtime['API_TOKEN'] = passwords['SATELLITE_API_TOKEN']
        runtime['PGVECTOR_PASSWORD'] = passwords['SATELLITE_PGSQL_PASSWORD']
        for name in ('SATELLITE_CALL_TRANSCRIPTION_ENABLED', 'SATELLITE_VOICEMAIL_TRANSCRIPTION_ENABLED'):
            runtime[name] = env.get(name, 'False')
    if agents:
        runtime['VOICE_AGENT_LIVE_WS_MAX_CALLS'] = env.get('VOICE_AGENT_LIVE_WS_MAX_CALLS', '2')
        for key, name in [('CHAT', 'VOICE_AGENT_CHAT_PORT'), ('RECIPIENT', 'NETHVOICE_RECIPIENT_SERVICE_PORT')]:
            runtime['VOICE_AGENT_' + key + '_URL'] = 'http://127.0.0.1:' + str(env[name])
    unit = (Path(os.environ['AGENT_INSTALL_DIR']) / 'systemd/user/satellite.service').read_text()
    external = {key: env.get(key, os.getenv(key, '')) for key in re.findall(r'\$\{(\w+)\}', unit)}
    image = run('podman', 'image', 'inspect', '--format', '{{.Id}}', os.environ['NETHVOICE_SATELLITE_IMAGE'],
                capture_output=True).stdout if needed else b''
    digest = hashlib.sha256(to_env(runtime) + unit.encode() + to_env(external) + image).hexdigest()
    running = active('satellite.service')
    route = env['NETHVOICE_HOST'] if sip else ''
    desired = {'digest': digest, 'agents': agents, 'route': route, 'flags': flags}
    if (previous == desired and running == needed and not Path('transcription-refresh.pending').exists()
            and (not agents or EFFECTIVE.exists())):
        return True

    # Recreate CTI and FreePBX only if their process-start transcription flags changed.
    consumers = previous.get('flags', flags) != flags or Path('transcription-refresh.pending').exists()
    if running and consumers and not pbx_idle():
        return False
    if running:
        check = subprocess.run(['podman', 'exec', 'satellite', 'python3', '-m', 'voice_agent.drain'])
        if check.returncode == 75:
            return False
        check.check_returncode()
    try:
        if consumers and running and not pbx_idle():
            run('podman', 'exec', 'satellite', 'python3', '-m', 'voice_agent.drain', '--cancel')
            return False
        PREVIEW.mkdir(exist_ok=True)
        PREVIEW.chmod(0o755)
        candidate = PREVIEW / 'candidate.env'
        write(candidate, to_env(settings), php=True)
        if agents:
            try:
                run('podman', 'exec', '--env', 'VOICE_AGENT_SETTINGS_FILE=/run/nethvoice-preview/candidate.env',
                    'freepbx', 'php', '/var/www/html/freepbx/rest/lib/agents/install-runtime.php', stderr=subprocess.PIPE)
            except subprocess.CalledProcessError as error:
                reason = (error.stderr or b'').decode(errors='replace').strip()
                if reason:
                    print(reason, file=sys.stderr)
                error.apply_error = reason if reason in INSTALL_ERRORS else None
                # On first setup a rejected Agents schema must not prevent transcription startup.
                if transcription and not running:
                    apply(transcription_only=True)
                raise
        write(STATE, json.dumps(dict(previous, applying=True)).encode())
        # Stop publishing the old PHP generation while the runtime is being replaced.
        visible = PREVIEW / 'enabled'
        visible.unlink(missing_ok=True)
        if EFFECTIVE.exists():
            write(EFFECTIVE, b'VOICE_AGENT_ENABLED=false\n', php=True)
        if running:
            ctl('stop', 'satellite.service')
        if needed:
            write(Path('satellite.env'), to_env(runtime))
            if transcription:
                ctl('enable', '--now', 'satellite-pgsql.service', 'satellite-mqtt.service')
            ctl('enable', '--now', 'satellite.service')
        else:
            ctl('disable', '--now', 'satellite.service')
            Path('satellite.env').unlink(missing_ok=True)
        if transcription:
            ctl('enable', '--now', 'satellite-recordings-cleanup.timer')
        else:
            ctl('disable', '--now', 'satellite-recordings-cleanup.timer', 'satellite-mqtt.service')
        if consumers:
            if not running:
                run('restart-services-when-convenient', '--wait-only')
            ctl('try-restart', 'freepbx.service', 'nethcti-server.service', 'nethcti-ui.service')
            Path('transcription-refresh.pending').unlink(missing_ok=True)
        if agents:
            wait_for_agents(settings['VOICE_AGENT_HTTP_PORT'], settings['VOICE_AGENT_RUNTIME_TOKEN'])
        candidate.replace(EFFECTIVE)
        if agents:
            visible.touch(mode=0o644)
            visible.chmod(0o644)
        if agents or (previous.get('agents') and not consumers):
            run('podman', 'exec', 'freepbx', '/usr/local/bin/configure-agent-recipient')
            run('podman', 'exec', 'freepbx', 'apache2ctl', '-k', 'graceful')
            run('podman', 'exec', 'freepbx', 'fwconsole', 'reload')
        if (previous.get('agents', False) != agents or not previous) and enabled(env, 'CHAT_ENABLED'):
            ctl('try-restart', 'chat-gateway.service')
        ctl('enable' if agents else 'disable', '--now', 'voice-agent-retention.timer')
        instance = os.environ['MODULE_ID'] + '-voice-agent-webhooks'
        if route:
            agent.set_route({'instance': instance, 'host': route, 'path': '/satellite-webhooks',
                             'url': 'http://127.0.0.1:' + str(env['VOICE_AGENT_HTTP_PORT']),
                             'strip_prefix': False, 'http2https': True})
        elif 'route' not in previous or previous['route'] or Path('satellite-runtime.sha256').exists():
            response = agent.tasks.run(agent_id=agent.resolve_agent_id('traefik@node'), action='delete-route',
                                       data={'instance': instance}, extra={'isNotificationHidden': True})
            agent.assert_exp(response['exit_code'] == 0)
        Path('satellite-runtime.sha256').unlink(missing_ok=True)
        write(STATE, json.dumps(desired).encode())
        return True
    except Exception:
        if running and active('satellite.service'):
            subprocess.run(['podman', 'exec', 'satellite', 'python3', '-m', 'voice_agent.drain', '--cancel'])
        raise


def main():
    os.umask(0o077)
    if PENDING.exists():
        PENDING.replace(RUNNING)
    elif not RUNNING.exists():
        return
    try:
        while not apply():
            time.sleep(5)
        FAILED.unlink(missing_ok=True)
    except Exception as error:
        # Existence still means failed; the content is only a stable reason code.
        reason = getattr(error, 'apply_error', None) or (error.args[0] if error.args else None)
        FAILED.write_text((reason if reason in APPLY_ERRORS else 'apply_failed') + '\n')
        raise
    finally:
        RUNNING.unlink(missing_ok=True)


if __name__ == '__main__':
    main()
