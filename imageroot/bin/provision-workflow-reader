#!/usr/bin/env python3
"""Refresh only the two SELECT grants used by the workflow PBX adapter."""
import re
import subprocess
import agent

passwords = agent.read_envfile('passwords.env')
password = passwords.get('SATELLITE_WORKFLOW_DB_PASSWORD', '')
if not re.fullmatch(r'[A-Za-z0-9_-]{20,128}', password):
    raise RuntimeError('Workflow reader password unavailable')
sql = ("GRANT SELECT ON phonebook.phonebook TO 'satellite_workflow'@'127.0.0.1' IDENTIFIED BY '" + password +
       "'; GRANT SELECT ON asteriskcdrdb.cdr TO 'satellite_workflow'@'127.0.0.1';")
# The SQL is sent over stdin, never printed or added to process arguments.
command = ['podman', 'exec', '-i', 'mariadb', 'sh', '-c',
           'exec mysql -uroot -p"$MARIADB_ROOT_PASSWORD" -h 127.0.0.1 -P "$NETHVOICE_MARIADB_PORT"']
subprocess.run(command, input=sql.encode(), check=True, stdout=subprocess.DEVNULL)
