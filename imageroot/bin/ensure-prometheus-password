import secrets

import agent

# Run before FreePBX reads passwords.env. This also handles upgrades and
# restores of backups taken before metrics credentials were introduced.
passwords = agent.read_envfile('passwords.env')
if not passwords.get('ASTERISK_PROMETHEUS_PASSWORD'):
    passwords['ASTERISK_PROMETHEUS_PASSWORD'] = secrets.token_hex(32)
    agent.write_envfile('passwords.env', passwords)
