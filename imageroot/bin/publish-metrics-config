# Publish the module alert rules and dashboards for the metrics module
# (ns8-metrics).
#
# Every etc/metrics/alert-rules/nethvoice-*.yml file is one field of the Redis
# hash module/<MODULE_ID>/metrics_alert_rules, and every
# etc/metrics/dashboards/nethvoice-*.json file is one field of
# module/<MODULE_ID>/metrics_dashboards, with __MODULE_ID__ replaced: each
# instance has its own dashboard. The metrics-alert-rules-changed and
# metrics-dashboard-changed events are sent only when a field really changes,
# so running this at every update does not reload Prometheus or restart
# Grafana for nothing. Fields not owned by this script are never touched. The
# hashes are deleted by the core when the module is removed.
#
# The alerts are off unless NETHVOICE_ALERTS_ENABLED is "True" (set-alerts
# action): when off, the owned rule fields are removed, while export-metrics
# keeps sending the metrics.
#
# The dashboards are not published automatically yet: without arguments only
# the rules are synced and the dashboards hash is left as it is. Install or
# refresh them by hand with "--dashboards install", remove them with
# "--dashboards remove".

import argparse
import fcntl
import os
import sys

import agent

FIELD_PREFIX = "nethvoice-"
RULES_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "etc", "metrics", "alert-rules")
DASHBOARDS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "etc", "metrics", "dashboards")
MODULE_ID_PLACEHOLDER = "__MODULE_ID__"
LOCK_FILE = "metrics-config.lock"


def owned_files(directory, suffix):
    """Return {field: file text} for the shipped files of this module."""
    files = {}
    for name in sorted(os.listdir(directory)):
        if name.startswith(FIELD_PREFIX) and name.endswith(suffix):
            with open(os.path.join(directory, name), encoding="utf-8") as fp:
                files[name[: -len(suffix)]] = fp.read()
    return files


def desired_rules(rules_dir=RULES_DIR):
    """Return {field: rule file text} for the shipped rule files."""
    return owned_files(rules_dir, ".yml")


def desired_dashboards(module_id, dashboards_dir=DASHBOARDS_DIR):
    """Return {field: dashboard JSON} of this instance for the shipped dashboards."""
    return {
        field: text.replace(MODULE_ID_PLACEHOLDER, module_id)
        for field, text in owned_files(dashboards_dir, ".json").items()
    }


def alerts_enabled(environ=os.environ):
    return environ.get("NETHVOICE_ALERTS_ENABLED", "False") == "True"


def sync(rdb, key, channel, fields):
    """Sync the owned fields of a hash; return True if something changed."""
    current = rdb.hgetall(key)
    pipe = rdb.pipeline()
    changed = False
    for field, text in fields.items():
        if current.get(field) != text:
            pipe.hset(key, field, text)
            changed = True
    for field in current:
        if field.startswith(FIELD_PREFIX) and field not in fields:
            pipe.hdel(key, field)
            changed = True
    if changed:
        pipe.publish(channel, "{}")
        pipe.execute()
    return changed


def publish(rdb, module_id, agent_id, rules):
    """Sync the rules hash; return True if something changed."""
    return sync(rdb, "module/%s/metrics_alert_rules" % module_id,
                "%s/event/metrics-alert-rules-changed" % agent_id, rules)


def publish_dashboards(rdb, module_id, agent_id, dashboards):
    """Sync the dashboards hash; return True if something changed."""
    return sync(rdb, "module/%s/metrics_dashboards" % module_id,
                "%s/event/metrics-dashboard-changed" % agent_id, dashboards)


def report(name, changed, fields):
    if not changed:
        state = "unchanged"
    elif fields:
        state = "published"
    else:
        state = "removed"
    print("%s %s" % (name, state), file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description="Publish the alert rules, or the dashboards, for the metrics module")
    parser.add_argument("--dashboards", choices=["install", "remove"],
                        help="install (or refresh) or remove the dashboards instead of syncing the alert rules")
    args = parser.parse_args()
    module_id = os.environ["MODULE_ID"]
    if args.dashboards:
        name = "dashboards"
        fields = desired_dashboards(module_id) if args.dashboards == "install" else {}
        do_publish = publish_dashboards
    else:
        name = "alert rules"
        fields = desired_rules() if alerts_enabled() else {}
        do_publish = publish
    with open(LOCK_FILE, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        rdb = agent.redis_connect(privileged=True)
        changed = do_publish(rdb, module_id, os.environ["AGENT_ID"], fields)
    report(name, changed, fields)


if __name__ == "__main__":
    main()
