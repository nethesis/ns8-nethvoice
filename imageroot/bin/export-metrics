# Print the module metrics in the Prometheus text format. The node runs this
# command every 5 minutes and adds the module label (ns8-core
# refresh-module-metrics). A failing collector is logged and reported by
# nethvoice_exporter_collector_up; the others are still exported.

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "pypkg"))

from nvmetrics import aikeys, dnscheck, runner, satellite, systemd  # noqa: E402

sys.stdout.write(runner.run([
    ("systemd", systemd.collect),
    ("public_dns", dnscheck.collect if dnscheck.enabled() else None),
    ("ai_keys", aikeys.collect if aikeys.enabled() else None),
    ("satellite", satellite.collect if satellite.enabled() else None),
]))
