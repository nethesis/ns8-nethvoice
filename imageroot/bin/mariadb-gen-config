# Writes the MariaDB settings that depend on the node, read by the mariadb
# container from /etc/mysql/conf.d. It runs before every start, so the values
# follow the node the module runs on, also after it is moved or restored.

import os
import re
import sys

import mariadb_tuning

CONFIG_FILE = 'mariadb-tuning.cnf'

size = os.getenv('NETHVOICE_MARIADB_INNODB_BUFFER_POOL_SIZE', '').strip()
if size and not re.fullmatch(r'[0-9]+[KMG]?', size):
    print('Ignoring NETHVOICE_MARIADB_INNODB_BUFFER_POOL_SIZE="%s": expected a size like 512M or 2G' % size, file=sys.stderr)
    size = ''
if not size:
    size = mariadb_tuning.default_buffer_pool_size()

content = '[mariadbd]\ninnodb_buffer_pool_size = %s\n' % size
try:
    with open(CONFIG_FILE) as f:
        if f.read() == content:
            sys.exit(0)
except OSError:
    pass
with open(CONFIG_FILE + '.tmp', 'w') as f:
    f.write(content)
os.replace(CONFIG_FILE + '.tmp', CONFIG_FILE)
print('MariaDB innodb_buffer_pool_size set to %s' % size, file=sys.stderr)
