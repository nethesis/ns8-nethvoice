# Sizes the InnoDB buffer pool for the node at every start: 1/8 of the memory,
# from 128M to 2G, unless NETHVOICE_MARIADB_INNODB_BUFFER_POOL_SIZE is set.

import os
import re
import sys

MIB = 1024 * 1024

def default_size():
    try:
        with open('/proc/meminfo') as f:
            memory = int(next(line for line in f if line.startswith('MemTotal:')).split()[1]) * 1024
    except (OSError, ValueError, StopIteration):
        memory = 0
    size = memory // 8 // (128 * MIB) * 128
    return '%dM' % max(128, min(2048, size))

size = os.getenv('NETHVOICE_MARIADB_INNODB_BUFFER_POOL_SIZE', '').strip()
if size and not re.fullmatch(r'[0-9]+[KMG]?', size):
    print('Ignoring invalid NETHVOICE_MARIADB_INNODB_BUFFER_POOL_SIZE: %s' % size, file=sys.stderr)
    size = ''
content = '[mariadbd]\ninnodb_buffer_pool_size = %s\n' % (size or default_size())

try:
    with open('mariadb-tuning.cnf') as f:
        if f.read() == content:
            sys.exit(0)
except OSError:
    pass
with open('mariadb-tuning.cnf.tmp', 'w') as f:
    f.write(content)
os.replace('mariadb-tuning.cnf.tmp', 'mariadb-tuning.cnf')
