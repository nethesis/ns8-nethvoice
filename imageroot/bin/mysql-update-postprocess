set -euo pipefail
exec 1>&2

# Run through runagent so newly allocated ports and proxy settings are visible.
mariadb_running=$(systemctl --user is-active mariadb || true)
if [[ "$mariadb_running" != active ]]; then
    trap 'systemctl --user stop mariadb' EXIT
    systemctl --user start mariadb
fi

# Historic call data is independent of the configuration schema. Start its
# resumable import only after the synchronous migrations have succeeded.
# Use SQL from the new image before replacing the running database container.
# This client never mounts the database volume.
podman run --rm --network=host \
    --env-file=./passwords.env \
    --env=NETHVOICE_MARIADB_PORT --env=AMPDBUSER \
    --env=ASTERISK_* --env=ASTMANAGERPORT --env=PROXY_IP --env=PROXY_PORT \
    --entrypoint=/usr/local/bin/nethvoice-db-init \
    "${NETHVOICE_MARIADB_IMAGE}" "$@"
