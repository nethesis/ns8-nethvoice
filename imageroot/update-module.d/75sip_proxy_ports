# Read the SIP ports published by the nethvoice-proxy before 80restart starts
# FreePBX, Tancredi and nethcti-server, so that they start with the ports the
# proxy uses. 90repoint_sip_proxy refreshes the SIP route later.

import sys

import agent

proxy_id = agent.resolve_agent_id('nethvoice-proxy@node')
if proxy_id is None:
    sys.exit(0)

ksrv = agent.list_service_providers(agent.redis_connect(use_replica=True), "sip", "tcp", {"module_id": proxy_id.removeprefix("module/")})
if not ksrv:
    sys.exit(0)

# A proxy that does not publish the ports uses the defaults
agent.set_env("NETHVOICE_PROXY_SIP_PORT", ksrv[0].get("sip_port", "5060"))
agent.set_env("NETHVOICE_PROXY_SIPS_PORT", ksrv[0].get("sips_port", "5061"))
