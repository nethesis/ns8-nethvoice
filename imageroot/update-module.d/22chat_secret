# NethVoice chat: component secret for installations created before the chat.
import secrets
import sys

import agent

passwords = agent.read_envfile('passwords.env')
if 'CHAT_COMPONENT_SECRET' not in passwords:
    passwords['CHAT_COMPONENT_SECRET'] = secrets.token_urlsafe(32)
    agent.write_envfile('passwords.env', passwords)
    print("chat: CHAT_COMPONENT_SECRET generated", file=sys.stderr)
