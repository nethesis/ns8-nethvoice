# NethVoice chat: component and service secrets for installations created before them.
import secrets
import sys

import agent

passwords = agent.read_envfile('passwords.env')
# The service secret signs the gateway's passwords for any account: never in ejabberd.yml.
missing = [k for k in ('CHAT_COMPONENT_SECRET', 'CHAT_SERVICE_SECRET') if k not in passwords]
for k in missing:
    passwords[k] = secrets.token_urlsafe(32)
if missing:
    agent.write_envfile('passwords.env', passwords)
    print(f"chat: {', '.join(missing)} generated", file=sys.stderr)
