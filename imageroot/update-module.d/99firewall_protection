import os
import subprocess

import agent


try:
    subprocess.run([
        os.path.join(
            os.environ['AGENT_INSTALL_DIR'],
            'bin',
            'nethvoice-firewall-protection',
        ),
        'add',
    ], check=True)
except (KeyError, OSError, subprocess.CalledProcessError):
    # The core update-module.d runner ignores child exit codes. Propagate the
    # failure through the action status channel so the update task is aborted.
    agent.set_status('validation-failed')
    raise
