# Apply the port values written to MariaDB at step 85mysql_update to the live
# Asterisk.
#
# A `fwconsole reload` regenerates the FreePBX-managed config from the database
# but does NOT rebind an already-loaded PJSIP transport. On an upgrade that
# changes the SIP UDP port, Asterisk would keep listening on the old port until
# the next full restart (QA finding B4). We therefore reload to regenerate the
# config and then restart Asterisk so the UDP transport is rebound, wait for it
# to come back, and verify the live transport uses the allocated port.
#
# Skip gracefully if FreePBX is not running (the config will be correct on the
# next start).

if ! systemctl --user is-active --quiet freepbx; then
    echo "FreePBX is not running, skipping reload/restart" >&2
    exit 0
fi

# Regenerate the FreePBX-managed configuration from the database
podman exec --user asterisk freepbx fwconsole reload --no-interaction || \
    echo "WARNING: fwconsole reload failed; continuing with restart" >&2

# Restart Asterisk so the PJSIP UDP transport is rebound to the new port
podman exec --user asterisk freepbx fwconsole restart --no-interaction

# Wait for Asterisk to be back up
attempt=0
until [[ $(podman exec freepbx asterisk -rx 'core show version' 2>/dev/null) == Asterisk* ]]; do
    if [ "$((attempt++))" -ge 60 ]; then
        echo "Asterisk did not come back after restart" >&2
        exit 1
    fi
    sleep 5
done

# Verify the live SIP UDP transport is bound to the allocated port
if ! podman exec freepbx asterisk -rx 'pjsip show transports' \
        | grep -qE ":${ASTERISK_SIP_UDP_PORT}([^0-9]|$)"; then
    echo "WARNING: SIP UDP transport is not bound to ${ASTERISK_SIP_UDP_PORT} after restart" >&2
fi
