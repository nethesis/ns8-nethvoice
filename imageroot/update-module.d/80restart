set -e

systemctl --user daemon-reload
runagent mysql-update-postprocess --migrate
runagent prepare-asterisk-config

echo "Restarting services when there are no active calls" >&2
restart-services-when-convenient mariadb freepbx janus nethcti-server nethcti-middleware nethcti-ui phonebook reports-api reports-redis reports-ui tancredi satellite-mqtt satellite-pgsql

# Retire the old agent container only after the call-safe restart above.
# A fresh action context also picks up ports allocated earlier in the update.
runagent manage-satellite
