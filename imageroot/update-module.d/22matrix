#!/usr/bin/env python3
"""Initialize Matrix settings once when upgrading an existing instance."""
import os
import secrets
import subprocess
import agent

env = agent.read_envfile('environment')
for name, value in (
    ('NETHVOICE_MATRIX_ENABLED', 'False'), ('NETHVOICE_MATRIX_HOST', ''),
    ('MATRIX_POSTGRES_USER', 'synapse'), ('MATRIX_POSTGRES_DB', 'synapse'),
):
    if name not in env:
        agent.set_env(name, value)

for name in ('MATRIX_POSTGRES_PORT', 'MATRIX_SYNAPSE_PORT', 'MATRIX_M2A_PORT',
             'NETHVOICE_MIDDLEWARE_MATRIX_PORT'):
    if name not in env:
        port, _ = agent.allocate_ports(1, 'tcp', keep_existing=True)
        agent.set_env(name, str(port))
        env[name] = str(port)
agent.set_env('NETHVOICE_MIDDLEWARE_MATRIX_LISTEN_ADDRESS',
              '127.0.0.1:' + env['NETHVOICE_MIDDLEWARE_MATRIX_PORT'])

passwords = agent.read_envfile('passwords.env')
for name in (
    'MATRIX_POSTGRES_PASSWORD', 'MATRIX_REGISTRATION_SECRET',
    'MATRIX_MACAROON_SECRET', 'MATRIX_FORM_SECRET', 'MATRIX_SYNAPSE_SECRET',
    'MATRIX_M2A_AS_TOKEN', 'MATRIX_M2A_HS_TOKEN', 'MATRIX_INTERNAL_AUTH_TOKEN',
):
    if name not in passwords:
        passwords[name] = secrets.token_urlsafe(48)
agent.write_envfile('passwords.env', passwords)

# Reuse the configure action with the current settings and allocated ports.
subprocess.run(['runagent', os.environ['AGENT_INSTALL_DIR'] +
                '/actions/configure-module/73matrix'], input='{}', text=True, check=True)
