# Some upgraded instances have SATELLITE_PGSQL_PORT on the same port as
# another local TCP service, usually NETHVOICE_MIDDLEWARE_PORT. Since 1.8 the
# middleware requires satellite-pgsql, so PostgreSQL takes the port first and
# the middleware cannot start. Move PostgreSQL only: its clients read the port
# from the environment and are restarted at 80restart.
#
# A new port is taken, in order of preference, from:
# 1. the instance TCP range (TCP_PORTS_RANGE): a port that no local TCP
#    service uses and nothing listens on. It is already reserved, so the TCP
#    ports quota does not change;
# 2. SATELLITE_PGSQL_SPARE_PORT, a single port allocated by an earlier run
#    and rejected because something was listening on it;
# 3. a new single-port allocation. The tcp-ports-demand label keeps one port
#    of headroom for it. A port that turns out to be in use is kept as
#    SATELLITE_PGSQL_SPARE_PORT, so a later update retries it instead of
#    taking one more port.
#
# The file name sorts after 20allocate_ports and 20allocate_video_gateway_ports,
# so the ports they need are allocated first.
import socket
import sys

import agent

# TCP ports this instance listens on, on the host network. Remote ports (for
# example NETHVOICE_HOTEL_FIAS_PORT) and UDP ports are left out on purpose.
LOCAL_TCP_PORT_VARS = (
    'APACHE_PORT',
    'ASTERISK_RECORDING_SFTP_PORT',
    'ASTERISK_SIP_PORT',
    'ASTERISK_SIPS_PORT',
    'ASTERISK_WS_PORT',
    'ASTERISK_WSS_PORT',
    'ASTMANAGERPORT',
    'CHAT_C2S_PORT',
    'CHAT_COMPONENT_PORT',
    'CHAT_GW_PORT',
    'CHAT_HTTP_PORT',
    'JANUS_TRANSPORT_PORT',
    'MEDIAMTX_API_PORT',
    'MEDIAMTX_ICE_TCP_PORT',
    'MEDIAMTX_RTSP_PORT',
    'MEDIAMTX_WHEP_PORT',
    'NETHCTI_DB_PORT',
    'NETHCTI_SERVER_API_PORT',
    'NETHCTI_SERVER_WS_PORT',
    'NETHCTI_TCP_PORT',
    'NETHCTI_TLS_PORT',
    'NETHCTI_UI_PORT',
    'NETHVOICE_LDAP_PORT',
    'NETHVOICE_MARIADB_PORT',
    'NETHVOICE_MIDDLEWARE_PORT',
    'OAUTH2_PROXY_PORT',
    'PHONEBOOK_DB_PORT',
    'PHONEBOOK_LDAP_PORT',
    'REPORTS_API_PORT',
    'REPORTS_REDIS_PORT',
    'REPORTS_UI_PORT',
    'SAML2_PROXY_PORT',
    'SATELLITE_HTTP_PORT',
    'SATELLITE_MQTT_PORT',
    'TANCREDIPORT',
) + tuple(f'NETHCTI_INTERNAL_REST_PORT{i}' for i in range(1, 14))


def is_free(port):
    """True if nothing listens on the TCP port, on any address"""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        try:
            sock.bind(('0.0.0.0', port))
        except OSError:
            return False
    return True


env = agent.read_envfile('environment')
pgsql_port = str(env.get('SATELLITE_PGSQL_PORT') or '')
clashing = [name for name in LOCAL_TCP_PORT_VARS if pgsql_port and str(env.get(name) or '') == pgsql_port]
if not clashing:
    sys.exit(0)

# Ports configured for local TCP services, plus the current PostgreSQL port.
# UDP and remote ports may share a number with a free TCP port.
taken = {str(env[name]).strip() for name in LOCAL_TCP_PORT_VARS if env.get(name)} | {pgsql_port}


def usable(port):
    return str(port) not in taken and is_free(int(port))


def range_ports():
    try:
        start, end = (int(value) for value in env['TCP_PORTS_RANGE'].split('-'))
    except (KeyError, ValueError):
        return []
    return list(range(start, end + 1))


spare = str(env.get('SATELLITE_PGSQL_SPARE_PORT') or '')
new_port = next((port for port in range_ports() if usable(port)), None)
if new_port is None and spare and usable(spare):
    new_port = int(spare)
if new_port is None and not spare:
    try:
        allocated = agent.allocate_ports(1, 'tcp', keep_existing=True)[0]
    except Exception as ex:
        allocated = None
        print(agent.SD_ERR + f"SATELLITE_PGSQL_PORT {pgsql_port} is also used by {', '.join(clashing)} and no TCP port can be allocated: {ex}", file=sys.stderr)
    if allocated is not None:
        if usable(allocated):
            new_port = allocated
        else:
            # Keep the reservation for the next update, do not take another one
            agent.set_env('SATELLITE_PGSQL_SPARE_PORT', str(allocated))
            print(agent.SD_ERR + f"Port {allocated} allocated for SATELLITE_PGSQL_PORT is already in use, kept as SATELLITE_PGSQL_SPARE_PORT", file=sys.stderr)

if new_port is None:
    # Do not stop the update: the rest of the instance keeps working
    print(agent.SD_ERR + f"SATELLITE_PGSQL_PORT {pgsql_port} is also used by {', '.join(clashing)}: no free TCP port, PostgreSQL keeps it", file=sys.stderr)
    sys.exit(0)

print(f"SATELLITE_PGSQL_PORT {pgsql_port} is also used by {', '.join(clashing)}: moved to {new_port}", file=sys.stderr)
agent.set_env('SATELLITE_PGSQL_PORT', str(new_port))
if spare and str(new_port) == spare:
    agent.unset_env('SATELLITE_PGSQL_SPARE_PORT')
