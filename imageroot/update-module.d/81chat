# Render chat and restart ejabberd. Satellite apply owns the gateway restart
# so it starts once against the applied consultation settings.
status=0
if [ "${CHAT_ENABLED:-false}" = "true" ]; then
    python3 "${AGENT_INSTALL_DIR}/actions/configure-module/45chat_routes" </dev/null || status=$?
    CHAT_FORCE_RESTART=1 CHAT_DEFER_GATEWAY=1 python3 "${AGENT_INSTALL_DIR}/actions/configure-module/46chat" </dev/null || status=$?
    touch chat-gateway-refresh.pending || status=$?
fi
runagent "${AGENT_INSTALL_DIR}/actions/configure-module/94voice_agents" || exit $?
exit "$status"
