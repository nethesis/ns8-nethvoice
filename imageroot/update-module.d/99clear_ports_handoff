# Keep retry state until all destination consumers confirm the current target.
# Update hooks are independent: a failure or best-effort skip in any consumer
# must not discard the ports still needed by the next update.

import agent

env = agent.read_envfile('environment')
new_port = env.get('ASTERISK_SIP_UDP_PORT')
if new_port and all(env.get(key) == new_port for key in (
    'SIP_PORTFORWARD_MIGRATED', 'SIP_PROXY_TRUNKS_MIGRATED',
    'SIP_PROXY_ROUTES_MIGRATED',
)):
    agent.unset_env('PREVIOUS_SIP_UDP_PORT')
    agent.unset_env('PREVIOUS_SIP_UDP_PORTS')
    agent.unset_env('SIP_PORTFORWARD_MIGRATED')
    agent.unset_env('SIP_PROXY_TRUNKS_MIGRATED')
    agent.unset_env('SIP_PROXY_ROUTES_MIGRATED')
