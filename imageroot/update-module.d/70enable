exec 1>&2

# Enable middleware service if it exists
# This is needed when updating from a version without middleware to one with middleware
# If the service doesn't exist, this command will simply fail without causing issues

echo "Enabling nethcti-middleware service for middleware support"
systemctl --user enable --now nethcti-middleware.service

# Enable NethVocice CDR cleanup timer
echo "Enabling nethvoice-cdr-cleanup timer"
systemctl --user enable --now nethvoice-cdr-cleanup.timer

# Enable scheduled queue statistics resets
echo "Enabling nethvoice-queue-stats-reset timer"
systemctl --user enable --now nethvoice-queue-stats-reset.timer
# Enable FreePBX external calendar synchronization timer
echo "Enabling nethvoice-calendar-sync timer"
systemctl --user enable --now nethvoice-calendar-sync.timer

# Enable NethCTI UI weekly restart timer for timezone updates
echo "Enabling nethcti-ui-restart timer"
systemctl --user enable --now nethcti-ui-restart.timer

# Start the shared runtime after the no-active-calls check in 80restart.
systemctl --user daemon-reload
systemctl --user enable satellite.service

systemctl --user enable --now voice-agent-retention.timer
