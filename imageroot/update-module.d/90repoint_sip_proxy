import json
import os
import re
import subprocess
import sys

import agent
import agent.tasks

env = agent.read_envfile("environment")
new_port = env["ASTERISK_SIP_UDP_PORT"]
agent.unset_env("SIP_PROXY_ROUTES_MIGRATED")
proxy_id = agent.resolve_agent_id("nethvoice-proxy@node")
if proxy_id is None:
    agent.set_env("SIP_PROXY_ROUTES_MIGRATED", new_port)
    sys.exit(0)

# Keep the primary route refresh in a fresh action context, as before.
agent.run_helper("runagent", os.path.join(
    os.environ["AGENT_INSTALL_DIR"], "actions/configure-module/60sip_proxy",
)).check_returncode()

ports = {env.get(key) for key in ("ASTERISK_SIP_PORT", "PREVIOUS_SIP_UDP_PORT")}
ports.update(json.loads(env.get("PREVIOUS_SIP_UDP_PORTS", "[]")))
# Reapply current destinations too: a previous write may have saved the new
# port before its live reload failed. No separate pending-route state is needed.
ports.add(new_port)
ports -= {None, ""}
uri_re = re.compile(r"^sip:(\[[^\]]+\]|[^:;/?@\s]+):(\d+)(.*)$", re.I)

try:
    interfaces = json.loads(subprocess.check_output(["ip", "-j", "address", "show"], text=True, timeout=10))
    local_addresses = {a["local"] for i in interfaces for a in i.get("addr_info", [])}
    response = agent.tasks.run(agent_id=proxy_id, action="list-routes", data={},
                               extra={"isNotificationHidden": True})
    if response["exit_code"] != 0:
        raise RuntimeError("Cannot list proxy routes")
    routes = response["output"]
    if isinstance(routes, str):
        routes = json.loads(routes)
    success = True
    for route in routes:
        if route["domain"] == env["NETHVOICE_HOST"]:
            continue
        addresses = [dict(a) for a in route["address"]]
        changed = False
        for address in addresses:
            uri = address["uri"]
            match = uri_re.match(uri)
            if not match:
                continue
            host, port, suffix = match.groups()
            transports = re.findall(r"(?:^|;)transport(?:=([^;]*))?(?=;|$)", suffix.split("?", 1)[0], re.I)
            if host.strip("[]") not in local_addresses or port not in ports or any(t.lower() != "udp" for t in transports):
                continue
            address["uri"] = uri[:match.start(2)] + new_port + uri[match.end(2):]
            changed = True
        if not changed:
            continue
        try:
            result = agent.tasks.run(agent_id=proxy_id, action="add-route",
                                     data={"domain": route["domain"], "address": addresses},
                                     extra={"isNotificationHidden": True})
            if result["exit_code"] != 0:
                raise RuntimeError("Route update failed")
        except Exception:
            success = False
            print(agent.SD_WARNING + f"Failed to refresh SIP route {route['domain']}; retry on next update",
                  file=sys.stderr)
    if success:
        agent.set_env("SIP_PROXY_ROUTES_MIGRATED", new_port)
except Exception as ex:
    print(agent.SD_WARNING + f"Cannot refresh additional SIP routes ({type(ex).__name__}); retry on next update",
          file=sys.stderr)
