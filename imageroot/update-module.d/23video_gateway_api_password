# Video gateway (MediaMTX): password of the control API user of
# nethcti-server, for instances created before it. The gateway asks
# nethcti-server to authorize every API request: without the password the API
# is refused and the sessions of the video sources are not revoked.
import secrets
import string
import sys

import agent

passwords = agent.read_envfile('passwords.env')
if not passwords.get('MEDIAMTX_API_PASSWORD'):
    pool = string.ascii_letters + string.digits
    passwords['MEDIAMTX_API_PASSWORD'] = ''.join(secrets.choice(pool) for _ in range(32))
    agent.write_envfile('passwords.env', passwords)
    print("video gateway: MEDIAMTX_API_PASSWORD generated", file=sys.stderr)
