# ejabberd with the chat programs: chat-extauth (ejabberd auth) and chat-gateway (push, Acrobits services).
FROM docker.io/library/golang:1.27.2-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags=-s -o /out/ ./cmd/...

# The page guests chat from, built and published with the chat-island.
FROM docker.io/library/golang:1.27.2-alpine AS guest
ARG CHAT_ISLAND=0.1.64
RUN wget -qO- https://registry.npmjs.org/@nethesis/chat-island/-/chat-island-${CHAT_ISLAND}.tgz | tar xz -C /tmp && mv /tmp/package/dist-guest /guest

FROM ghcr.io/processone/ejabberd:26.07
COPY --from=build /out/chat-extauth /out/chat-gateway /opt/ejabberd/bin/
COPY --from=guest /guest /opt/ejabberd/guest
